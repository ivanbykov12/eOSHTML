{
  "id": "settings_desktop",
  "name": "Настройки",
  "icon": "material:settings",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/system-settings-2026-09-23/1024.png&w=512",
  "color": "from-gray-500 to-slate-700",
  "version": "2.2.0-LIQUID",
  "author": "eOS System",
  "description": "System Settings for eOS Desktop with Liquid Glass UI",
  "supportedModels": ["eosdesktop", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "transparent",
  "code": "<div class='settings-root'>\n  <aside class='sidebar'>\n    <div class='profile-card' onclick='openEppleId()'>\n      <div class='avatar'><span class='material-icons'>person</span></div>\n      <div class='info'>\n        <div class='name' id='userName'>User</div>\n        <div class='sub'>Epple ID & iCloud</div>\n      </div>\n      <span class='material-icons chevron'>chevron_right</span>\n    </div>\n    <nav class='menu'>\n      <div class='item active' data-page='general' onclick=\"nav('general')\">\n        <span class='material-icons'>tune</span> Основные\n      </div>\n      <div class='item' data-page='appearance' onclick=\"nav('appearance')\">\n        <span class='material-icons'>palette</span> Внешний вид\n      </div>\n      <div class='item' data-page='wallpaper' onclick=\"nav('wallpaper')\">\n        <span class='material-icons'>wallpaper</span> Обои\n      </div>\n      <div class='item' data-page='display' onclick=\"nav('display')\">\n        <span class='material-icons'>monitor</span> Дисплей\n      </div>\n      <div class='item' data-page='touch' onclick=\"nav('touch')\">\n        <span class='material-icons'>touch_app</span> Сенсор\n      </div>\n      <div class='item' data-page='sound' onclick=\"nav('sound')\">\n        <span class='material-icons'>volume_up</span> Звук\n      </div>\n      <div class='item' data-page='network' onclick=\"nav('network')\">\n        <span class='material-icons'>wifi</span> Сеть\n      </div>\n      <div class='item' data-page='about' onclick=\"nav('about')\">\n        <span class='material-icons'>info</span> О системе\n      </div>\n    </nav>\n  </aside>\n  <main class='content'>\n    <section id='page-general' class='page active'>\n      <h2>Основные</h2>\n      <div class='card'>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#007aff'>wifi</span>\n          <span class='label'>Wi-Fi</span>\n          <span class='value'>Подключено</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#007aff'>bluetooth</span>\n          <span class='label'>Bluetooth</span>\n          <span class='value'>Вкл.</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n        <div class='row'>\n          <span class='label'>Имя устройства</span>\n          <input type='text' class='glass-input' id='devNameInput' onchange=\"updateSetting('name', this.value)\">\n        </div>\n        <div class='row'>\n          <span class='label'>Язык системы</span>\n          <span class='value'>Русский</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n      </div>\n      <div class='card'>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#ff9500'>storage</span>\n          <span class='label'>Хранилище</span>\n          <span class='value'>42 ГБ из 256 ГБ</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#34c759'>security</span>\n          <span class='label'>Конфиденциальность</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n      </div>\n    </section>\n    <section id='page-appearance' class='page'>\n      <h2>Внешний вид</h2>\n      <div class='card'>\n        <div class='row'>\n          <span class='label'>Тёмная тема</span>\n          <label class='switch'>\n            <input type='checkbox' id='darkToggle' onchange=\"toggleDarkMode(this.checked)\">\n            <span class='slider'></span>\n          </label>\n        </div>\n        <div class='row-col'>\n          <span class='label'>Яркость</span>\n          <input type='range' min='30' max='100' value='100' id='brightRange' oninput=\"setBrightness(this.value)\">\n          <div class='val-center' id='brightVal'>100%</div>\n        </div>\n        <div class='row-col'>\n          <span class='label'>Акцентный цвет</span>\n          <div class='color-picker'>\n            <div class='color-dot' style='background:#007aff' onclick=\"setAccent('#007aff')\"></div>\n            <div class='color-dot' style='background:#af52de' onclick=\"setAccent('#af52de')\"></div>\n            <div class='color-dot' style='background:#ff2d55' onclick=\"setAccent('#ff2d55')\"></div>\n            <div class='color-dot' style='background:#ff9500' onclick=\"setAccent('#ff9500')\"></div>\n            <div class='color-dot' style='background:#34c759' onclick=\"setAccent('#34c759')\"></div>\n            <div class='color-dot' style='background:#5ac8fa' onclick=\"setAccent('#5ac8fa')\"></div>\n          </div>\n        </div>\n      </div>\n      <div class='hint'>Стиль Liquid Glass применяется ко всем системным окнам автоматически.</div>\n    </section>\n    <section id='page-wallpaper' class='page'>\n      <h2>Обои</h2>\n      <div class='card'>\n        <div class='row-col'>\n          <span class='label'>Выберите обои для рабочего стола</span>\n          <div class='wallpaper-grid'>\n            <div class='wallpaper-item' onclick=\"setWallpaper('sonoma')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/5e8ac870-af53-4f3f-a451-4014bb9cce09/_result.png)'></div>\n              <div class='wallpaper-name'>Sonoma</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('bigsur')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/cfe887e6-0d34-4121-ae61-d980f7f2ecf8/_result.png)'></div>\n              <div class='wallpaper-name'>Big Sur</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('monterey')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/a6a9c548-7421-4e93-85ad-7fe39d5cb927/_result.png)'></div>\n              <div class='wallpaper-name'>Monterey</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('ventura')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/25f669e0-4fcb-4537-80d5-26bb29fd4cc1/_result.png)'></div>\n              <div class='wallpaper-name'>Ventura</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('light')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/236cde49-69c8-4827-bc70-4b62766a4281/_result.png)'></div>\n              <div class='wallpaper-name'>Light</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('space')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/0969db3b-7db6-4961-a8da-92b7ec995f34/_result.png)'></div>\n              <div class='wallpaper-name'>Space</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('sierra')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/84b20227-8aad-4add-bfb5-a8adfcd241ce/_result.png)'></div>\n              <div class='wallpaper-name'>Sierra</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('metal')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/97c7d6c0-4ec9-4433-b217-16982cbccf1e/_result.png)'></div>\n              <div class='wallpaper-name'>Metal</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('elcapitan')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/d3fcfa86-c283-4e5a-966f-aad370d97a29/_result.png)'></div>\n              <div class='wallpaper-name'>El Capitan</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('yosemite')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/a19fc1a8-c091-4a0a-9966-f14f1f99979c/_result.png)'></div>\n              <div class='wallpaper-name'>Yosemite</div>\n            </div>\n            <div class='wallpaper-item' onclick=\"setWallpaper('minimal')\">\n              <div class='wallpaper-preview' style='background-image:url(https://image.qwenlm.ai/generated-images/4220ad90-2f63-43fd-826b-2351aa6d7b7c/_result.png)'></div>\n              <div class='wallpaper-name'>Minimal</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class='hint'>Обои применяются мгновенно и сохраняются в настройках системы.</div>\n    </section>\n    <section id='page-display' class='page'>\n      <h2>Дисплей</h2>\n      <div class='card'>\n        <div class='row-col'>\n          <span class='label'>Разрешение</span>\n          <span class='value' id='screenResolution'>Определение...</span>\n        </div>\n        <div class='row'>\n          <span class='label'>Night Shift</span>\n          <label class='switch'>\n            <input type='checkbox'>\n            <span class='slider'></span>\n          </label>\n        </div>\n        <div class='row'>\n          <span class='label'>True Tone</span>\n          <label class='switch'>\n            <input type='checkbox' checked>\n            <span class='slider'></span>\n          </label>\n        </div>\n      </div>\n    </section>\n    <section id='page-touch' class='page'>\n      <h2>Сенсор и доступность</h2>\n      <div class='card'>\n        <div class='row'>\n          <span class='label'>Режим сенсорного управления</span>\n          <label class='switch'>\n            <input type='checkbox' id='touchToggle' onchange=\"toggleTouchMode(this.checked)\">\n            <span class='slider'></span>\n          </label>\n        </div>\n        <div class='hint' style='padding: 0 16px 12px;'>Увеличивает размеры кнопок и элементов управления для удобства на сенсорных экранах</div>\n        <div class='row-col'>\n          <span class='label'>Размер кнопок</span>\n          <div class='button-size-selector'>\n            <button class='size-btn' data-size='small' onclick=\"setButtonSize('small')\">\n              <span class='size-preview small'></span>\n              <span>Маленькие</span>\n            </button>\n            <button class='size-btn active' data-size='medium' onclick=\"setButtonSize('medium')\">\n              <span class='size-preview medium'></span>\n              <span>Средние</span>\n            </button>\n            <button class='size-btn' data-size='large' onclick=\"setButtonSize('large')\">\n              <span class='size-preview large'></span>\n              <span>Большие</span>\n            </button>\n          </div>\n        </div>\n        <div class='row-col'>\n          <span class='label'>Размер текста</span>\n          <input type='range' min='12' max='20' value='14' id='fontSizeRange' oninput=\"setFontSize(this.value)\">\n          <div class='val-center' id='fontSizeVal'>14px</div>\n        </div>\n      </div>\n      <div class='card'>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#007aff'>vibration</span>\n          <span class='label'>Виброотклик</span>\n          <label class='switch'>\n            <input type='checkbox' checked>\n            <span class='slider'></span>\n          </label>\n        </div>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#34c759'>gesture</span>\n          <span class='label'>Жесты</span>\n          <label class='switch'>\n            <input type='checkbox' checked>\n            <span class='slider'></span>\n          </label>\n        </div>\n      </div>\n      <div class='card'>\n        <div class='row-col'>\n          <span class='label'>Установить приложение из файла</span>\n          <input type='file' id='eappFileInput' accept='.eapp' onchange=\"installEapp(this)\" style='display:none;'>\n          <button class='install-btn' onclick=\"document.getElementById('eappFileInput').click()\">\n            <span class='material-icons'>upload_file</span>\n            Выбрать .eapp файл\n          </button>\n          <div class='hint'>Выберите файл .eapp для установки в систему</div>\n        </div>\n      </div>\n      <div class='hint'>Настройки применяются ко всем приложениям системы.</div>\n    </section>\n    <section id='page-sound' class='page'>\n      <h2>Звук</h2>\n      <div class='card'>\n        <div class='row-col'>\n          <span class='label'>Громкость</span>\n          <input type='range' min='0' max='100' value='75'>\n        </div>\n        <div class='row'>\n          <span class='label'>Звуковые эффекты</span>\n          <label class='switch'>\n            <input type='checkbox' checked>\n            <span class='slider'></span>\n          </label>\n        </div>\n        <div class='row'>\n          <span class='label'>Устройство вывода</span>\n          <span class='value'>Встроенные динамики</span>\n          <span class='material-icons chevron'>chevron_right</span>\n        </div>\n      </div>\n    </section>\n    <section id='page-network' class='page'>\n      <h2>Сеть</h2>\n      <div class='card'>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#007aff'>wifi</span>\n          <span class='label'>Wi-Fi</span>\n          <span class='value' style='color:#34c759'>Подключено</span>\n        </div>\n        <div class='row'>\n          <span class='label'>Сеть</span>\n          <span class='value'>eOS-Network-5G</span>\n        </div>\n        <div class='row'>\n          <span class='label'>IP-адрес</span>\n          <span class='value mono'>192.168.1.42</span>\n        </div>\n      </div>\n      <div class='card'>\n        <div class='row'>\n          <span class='material-icons icon' style='color:#007aff'>bluetooth</span>\n          <span class='label'>Bluetooth</span>\n          <span class='value' style='color:#34c759'>Вкл.</span>\n        </div>\n        <div class='row'>\n          <span class='label'>Устройства</span>\n          <span class='value'>AirPods Pro</span>\n        </div>\n      </div>\n    </section>\n    <section id='page-about' class='page'>\n      <h2>О системе</h2>\n      <div class='about-box'>\n        <span class='material-icons about-icon'>computer</span>\n        <div class='model-name' id='sysModel'>Macbook 13 Pro</div>\n        <div class='os-ver' id='sysVer'>eOS Desktop</div>\n        <div class='kernel'>Kernel: eOS-Darwin 23.0</div>\n      </div>\n      <div class='card'>\n        <div class='row'><span class='label'>Процессор</span><span class='value'>Apple M3 Pro</span></div>\n        <div class='row'><span class='label'>Память</span><span class='value'>18 ГБ</span></div>\n        <div class='row'><span class='label'>Серийный номер</span><span class='value mono'>FVFXXXXXXXXX</span></div>\n        <div class='row'><span class='label'>API Context</span><span class='value mono' id='apiCtx'>-</span></div>\n        <div class='row'><span class='label'>RBAC Level</span><span class='value mono' id='rbacLvl'>-</span></div>\n        <div class='row'><span class='label'>eApp Version</span><span class='value mono'>1.1</span></div>\n      </div>\n    </section>\n  </main>\n</div>\n<style>\n.settings-root { display: flex; height: 100vh; font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif; overflow: hidden; background: var(--bg-primary, #1e1e1e); color: var(--text-primary, #f5f5f7); }\n.sidebar { width: 220px; padding: 16px 10px; display: flex; flex-direction: column; gap: 8px; margin: 10px; background: var(--bg-tertiary, rgba(255, 255, 255, 0.05)); border-radius: 16px; overflow-y: auto; }\n.content { flex: 1; padding: 20px; overflow-y: auto; }\n.page { display: none; animation: fadeIn 0.3s ease; }\n.page.active { display: block; }\n@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n.profile-card { display: flex; align-items: center; gap: 10px; padding: 10px; background: rgba(0, 122, 255, 0.1); border-radius: 12px; cursor: pointer; margin-bottom: 8px; transition: 0.2s; }\n.profile-card:hover { background: rgba(0, 122, 255, 0.15); }\n.avatar { width: 36px; height: 36px; background: linear-gradient(135deg, #667eea, #764ba2); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; flex-shrink: 0; }\n.info { flex: 1; }\n.info .name { font-weight: 600; font-size: 13px; }\n.info .sub { font-size: 11px; opacity: 0.6; }\n.profile-card .chevron { opacity: 0.4; font-size: 18px; }\n.menu .item { display: flex; align-items: center; gap: 10px; padding: 7px 12px; border-radius: 8px; cursor: pointer; font-size: 13px; transition: 0.2s; opacity: 0.7; }\n.menu .item:hover, .menu .item.active { background: rgba(0, 122, 255, 0.15); opacity: 1; }\n.menu .item .material-icons { font-size: 18px; }\nh2 { margin: 0 0 16px; font-size: 20px; font-weight: 600; }\n.card { background: var(--bg-tertiary, rgba(255, 255, 255, 0.05)); border-radius: 12px; overflow: hidden; margin-bottom: 16px; border: 1px solid var(--border-color, rgba(255, 255, 255, 0.1)); }\n.row { display: flex; align-items: center; padding: 11px 16px; border-bottom: 1px solid var(--border-color, rgba(255, 255, 255, 0.08)); font-size: 13px; }\n.row:last-child { border-bottom: none; }\n.row .icon { margin-right: 12px; font-size: 20px; width: 24px; text-align: center; }\n.row .label { flex: 1; }\n.row .value { opacity: 0.6; font-size: 12px; margin-right: 8px; }\n.row .chevron { opacity: 0.4; font-size: 18px; }\n.switch { position: relative; width: 40px; height: 22px; flex-shrink: 0; }\n.switch input { opacity: 0; width: 0; height: 0; }\n.slider { position: absolute; inset: 0; background: #555; border-radius: 22px; transition: 0.3s; cursor: pointer; }\n.slider:before { content: ''; position: absolute; height: 18px; width: 18px; left: 2px; bottom: 2px; background: white; border-radius: 50%; transition: 0.3s; }\ninput:checked + .slider { background: #34c759; }\ninput:checked + .slider:before { transform: translateX(18px); }\n.glass-input { background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 6px; padding: 4px 8px; font-size: 13px; outline: none; width: 140px; text-align: right; color: inherit; }\n.glass-input:focus { border-color: #007aff; }\n.row-col { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.08); }\n.row-col:last-child { border-bottom: none; }\n.row-col input[type=range] { width: 100%; accent-color: #007aff; }\n.val-center { text-align: center; font-size: 12px; opacity: 0.6; }\n.hint { font-size: 12px; opacity: 0.5; margin-top: 10px; font-style: italic; }\n.about-box { text-align: center; padding: 24px; background: rgba(255, 255, 255, 0.05); border-radius: 16px; margin-bottom: 16px; border: 1px solid rgba(255, 255, 255, 0.1); }\n.about-icon { font-size: 48px !important; opacity: 0.7; margin-bottom: 8px; display: block; }\n.model-name { font-size: 20px; font-weight: 700; }\n.os-ver { font-size: 13px; opacity: 0.6; margin-top: 4px; }\n.kernel { font-size: 11px; opacity: 0.4; margin-top: 6px; font-family: monospace; }\n.mono { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 12px; }\n.color-picker { display: flex; gap: 8px; flex-wrap: wrap; }\n.color-dot { width: 24px; height: 24px; border-radius: 50%; cursor: pointer; transition: transform 0.2s; border: 2px solid transparent; }\n.color-dot:hover { transform: scale(1.2); border-color: rgba(255, 255, 255, 0.5); }\n.wallpaper-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 12px; }\n.wallpaper-item { cursor: pointer; transition: transform 0.2s; border-radius: 8px; overflow: hidden; border: 2px solid transparent; }\n.wallpaper-item:hover { transform: scale(1.05); border-color: #007aff; }\n.wallpaper-preview { width: 100%; height: 80px; background-size: cover; background-position: center; }\n.wallpaper-name { padding: 6px; text-align: center; font-size: 11px; background: rgba(255, 255, 255, 0.05); }\n.button-size-selector { display: flex; gap: 8px; }\n.size-btn { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 12px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 8px; cursor: pointer; transition: 0.2s; color: inherit; font-size: 12px; }\n.size-btn:hover { background: rgba(255, 255, 255, 0.1); }\n.size-btn.active { background: rgba(0, 122, 255, 0.15); border-color: #007aff; }\n.size-preview { display: block; border-radius: 4px; background: #007aff; }\n.size-preview.small { width: 24px; height: 24px; }\n.size-preview.medium { width: 32px; height: 32px; }\n.size-preview.large { width: 40px; height: 40px; }\n.install-btn { display: flex; align-items: center; gap: 8px; padding: 12px 20px; background: #007aff; color: white; border: none; border-radius: 10px; font-size: 14px; font-weight: 500; cursor: pointer; transition: 0.2s; width: 100%; justify-content: center; }\n.install-btn:hover { background: #0056b3; }\n.install-btn .material-icons { font-size: 20px; }\n</style>\n<script>\nvar s = window.ePhone ? window.ePhone.getSettings() : {};\nvar ctx = window.ePhoneContext || {};\n\ndocument.getElementById('userName').textContent = s.name || 'User';\ndocument.getElementById('devNameInput').value = s.name || 'ePhone';\ndocument.getElementById('darkToggle').checked = !!s.darkMode;\ndocument.getElementById('brightRange').value = s.brightness || 100;\ndocument.getElementById('brightVal').textContent = (s.brightness || 100) + '%';\ndocument.getElementById('touchToggle').checked = !!s.touchMode;\ndocument.getElementById('fontSizeRange').value = s.fontSize || 14;\ndocument.getElementById('fontSizeVal').textContent = (s.fontSize || 14) + 'px';\n\nvar currentSize = s.buttonSize || 'medium';\ndocument.querySelectorAll('.size-btn').forEach(function(btn) {\n  btn.classList.toggle('active', btn.dataset.size === currentSize);\n});\n\nif (window.ePhoneConsole) {\n  window.ePhoneConsole.execute('model').then(function(res) {\n    document.getElementById('sysModel').textContent = res.split('\\n')[0] || ctx.modelName || 'Unknown';\n  });\n} else {\n  document.getElementById('sysModel').textContent = ctx.modelName || 'Macbook 13 Pro';\n}\n\ndocument.getElementById('sysVer').textContent = 'eOS Desktop ' + (ctx.osVersion || '10.1 beta');\ndocument.getElementById('apiCtx').textContent = ctx.model || 'eosdesktop';\ndocument.getElementById('rbacLvl').textContent = (window.ePhone && window.ePhone.getRBACLevel) ? window.ePhone.getRBACLevel() : 'USER';\n\n// Определение реального разрешения экрана\nvar screenWidth = window.screen.width;\nvar screenHeight = window.screen.height;\nvar pixelRatio = window.devicePixelRatio || 1;\nvar actualWidth = Math.round(screenWidth * pixelRatio);\nvar actualHeight = Math.round(screenHeight * pixelRatio);\ndocument.getElementById('screenResolution').textContent = actualWidth + ' × ' + actualHeight + (pixelRatio > 1 ? ' (Retina)' : '');\n\nfunction nav(pageId) {\n  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });\n  document.getElementById('page-' + pageId).classList.add('active');\n  document.querySelectorAll('.menu .item').forEach(function(i) { i.classList.remove('active'); });\n  var item = document.querySelector('.menu .item[data-page=\"' + pageId + '\"]');\n  if (item) item.classList.add('active');\n}\n\nfunction openEppleId() {\n  window.parent.postMessage({ type: 'eos-open-app', appId: 'epple_id' }, '*');\n}\n\nfunction updateSetting(key, val) {\n  if (window.ePhone) window.ePhone.setSettings({ name: val });\n}\n\nfunction toggleDarkMode(isChecked) {\n  if (window.ePhone) window.ePhone.setSettings({ darkMode: isChecked });\n  window.parent.postMessage({ type: 'eos-settings-change', darkMode: isChecked }, '*');\n}\n\nfunction setBrightness(val) {\n  document.getElementById('brightVal').textContent = val + '%';\n  if (window.ePhone) window.ePhone.setSettings({ brightness: parseInt(val) });\n  window.parent.postMessage({ type: 'eos-settings-change', brightness: parseInt(val) }, '*');\n}\n\nfunction setAccent(color) {\n  if (window.ePhone) window.ePhone.setSettings({ accentColor: color });\n}\n\nfunction setWallpaper(name) {\n  var wallpapers = {\n    'sonoma': 'https://image.qwenlm.ai/generated-images/5e8ac870-af53-4f3f-a451-4014bb9cce09/_result.png',\n    'bigsur': 'https://image.qwenlm.ai/generated-images/cfe887e6-0d34-4121-ae61-d980f7f2ecf8/_result.png',\n    'monterey': 'https://image.qwenlm.ai/generated-images/a6a9c548-7421-4e93-85ad-7fe39d5cb927/_result.png',\n    'ventura': 'https://image.qwenlm.ai/generated-images/25f669e0-4fcb-4537-80d5-26bb29fd4cc1/_result.png',\n    'light': 'https://image.qwenlm.ai/generated-images/236cde49-69c8-4827-bc70-4b62766a4281/_result.png',\n    'space': 'https://image.qwenlm.ai/generated-images/0969db3b-7db6-4961-a8da-92b7ec995f34/_result.png',\n    'sierra': 'https://image.qwenlm.ai/generated-images/84b20227-8aad-4add-bfb5-a8adfcd241ce/_result.png',\n    'metal': 'https://image.qwenlm.ai/generated-images/97c7d6c0-4ec9-4433-b217-16982cbccf1e/_result.png',\n    'elcapitan': 'https://image.qwenlm.ai/generated-images/d3fcfa86-c283-4e5a-966f-aad370d97a29/_result.png',\n    'yosemite': 'https://image.qwenlm.ai/generated-images/a19fc1a8-c091-4a0a-9966-f14f1f99979c/_result.png',\n    'minimal': 'https://image.qwenlm.ai/generated-images/4220ad90-2f63-43fd-826b-2351aa6d7b7c/_result.png'\n  };\n  if (window.ePhone) window.ePhone.setSettings({ wallpaper: wallpapers[name] });\n  window.parent.postMessage({ type: 'eos-wallpaper-change', wallpaper: wallpapers[name] }, '*');\n}\n\nfunction toggleTouchMode(isChecked) {\n  if (window.ePhone) window.ePhone.setSettings({ touchMode: isChecked });\n  window.parent.postMessage({ type: 'eos-settings-change', touchMode: isChecked }, '*');\n}\n\nfunction setButtonSize(size) {\n  document.querySelectorAll('.size-btn').forEach(function(btn) {\n    btn.classList.toggle('active', btn.dataset.size === size);\n  });\n  if (window.ePhone) window.ePhone.setSettings({ buttonSize: size });\n  window.parent.postMessage({ type: 'eos-settings-change', buttonSize: size }, '*');\n}\n\nfunction setFontSize(val) {\n  document.getElementById('fontSizeVal').textContent = val + 'px';\n  if (window.ePhone) window.ePhone.setSettings({ fontSize: parseInt(val) });\n  window.parent.postMessage({ type: 'eos-settings-change', fontSize: parseInt(val) }, '*');\n}\n\nfunction installEapp(input) {\n  var file = input.files[0];\n  if (!file) return;\n  \n  var reader = new FileReader();\n  reader.onload = function(e) {\n    try {\n      var appData = JSON.parse(e.target.result);\n      window.parent.postMessage({\n        type: 'eapp-install-from-file',\n        app: appData\n      }, '*');\n      alert('Приложение \"' + appData.name + '\" успешно установлено!');\n    } catch (err) {\n      alert('Ошибка: неверный формат .eapp файла');\n    }\n  };\n  reader.readAsText(file);\n  input.value = '';\n}\n</script>"
}
