{
  "id": "appstore_desktop",
  "name": "App Store",
  "icon": "material:store",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/app-store-2026-09-23/1024.png&w=512",
  "color": "from-blue-500 to-indigo-600",
  "version": "2.0.0",
  "author": "eOS System",
  "description": "eOS Application Store",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='store-root'>\n  <aside class='sidebar'>\n    <div class='logo'>\n      <span class='material-icons'>store</span>\n      <span>App Store</span>\n    </div>\n    <nav class='nav'>\n      <div class='nav-item active' onclick=\"showSection('discover')\">\n        <span class='material-icons'>explore</span> Обзор\n      </div>\n      <div class='nav-item' onclick=\"showSection('categories')\">\n        <span class='material-icons'>category</span> Категории\n      </div>\n      <div class='nav-item' onclick=\"showSection('installed')\">\n        <span class='material-icons'>download_done</span> Установленные\n      </div>\n      <div class='nav-item' onclick=\"showSection('updates')\">\n        <span class='material-icons'>update</span> Обновления\n      </div>\n    </nav>\n    <div class='drop-zone'>\n      <span class='material-icons'>cloud_upload</span>\n      <p>Перетащите .eapp файл сюда</p>\n    </div>\n  </aside>\n  <main class='main'>\n    <div id='section-discover' class='section active'>\n      <div class='banner'>\n        <div class='banner-content'>\n          <h2>Приложение дня</h2>\n          <p>eOS Calculator Pro — мощный калькулятор с поддержкой формул</p>\n          <button class='btn-primary' onclick=\"installApp('calculator')\">Установить</button>\n        </div>\n        <div class='banner-icon'>\n          <span class='material-icons'>calculate</span>\n        </div>\n      </div>\n      <h3 class='section-title'>Рекомендуемые</h3>\n      <div class='app-grid'>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#a855f7,#ec4899)'>\n            <span class='material-icons'>brush</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>eOS Paint</div>\n            <div class='app-desc'>Рисование и графика</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('paint')\">Установить</button>\n        </div>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#22c55e,#14b8a6)'>\n            <span class='material-icons'>code</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>Code Editor</div>\n            <div class='app-desc'>Редактор кода</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('codeeditor')\">Установить</button>\n        </div>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#f97316,#ef4444)'>\n            <span class='material-icons'>music_note</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>Music Player</div>\n            <div class='app-desc'>Музыкальный плеер</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('music')\">Установить</button>\n        </div>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#06b6d4,#3b82f6)'>\n            <span class='material-icons'>cloud</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>Weather</div>\n            <div class='app-desc'>Прогноз погоды</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('weather')\">Установить</button>\n        </div>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#eab308,#f97316)'>\n            <span class='material-icons'>photo_camera</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>Photos</div>\n            <div class='app-desc'>Просмотр фото</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('photos')\">Установить</button>\n        </div>\n        <div class='app-card'>\n          <div class='app-icon' style='background:linear-gradient(135deg,#6366f1,#a855f7)'>\n            <span class='material-icons'>games</span>\n          </div>\n          <div class='app-info'>\n            <div class='app-name'>eOS Games</div>\n            <div class='app-desc'>Коллекция игр</div>\n          </div>\n          <button class='btn-primary small' onclick=\"installApp('games')\">Установить</button>\n        </div>\n      </div>\n    </div>\n    <div id='section-categories' class='section'>\n      <h3 class='section-title'>Категории</h3>\n      <div class='categories-grid'>\n        <div class='category-card'><span class='material-icons'>work</span>Продуктивность</div>\n        <div class='category-card'><span class='material-icons'>palette</span>Дизайн</div>\n        <div class='category-card'><span class='material-icons'>code</span>Разработка</div>\n        <div class='category-card'><span class='material-icons'>music_note</span>Музыка</div>\n        <div class='category-card'><span class='material-icons'>games</span>Игры</div>\n        <div class='category-card'><span class='material-icons'>education</span>Образование</div>\n      </div>\n    </div>\n    <div id='section-installed' class='section'>\n      <h3 class='section-title'>Установленные приложения</h3>\n      <div class='installed-list' id='installedList'>\n        <div class='installed-item'>\n          <div class='app-icon-sm' style='background:linear-gradient(135deg,#6b7280,#334155)'><span class='material-icons'>settings</span></div>\n          <div class='app-info'><div class='app-name'>Настройки</div><div class='app-desc'>v2.0.0-LIQUID</div></div>\n          <span class='badge'>Системное</span>\n        </div>\n        <div class='installed-item'>\n          <div class='app-icon-sm' style='background:linear-gradient(135deg,#1f2937,#000)'><span class='material-icons'>terminal</span></div>\n          <div class='app-info'><div class='app-name'>Терминал</div><div class='app-desc'>v2.0.0</div></div>\n          <span class='badge'>Системное</span>\n        </div>\n        <div class='installed-item'>\n          <div class='app-icon-sm' style='background:linear-gradient(135deg,#60a5fa,#2563eb)'><span class='material-icons'>folder</span></div>\n          <div class='app-info'><div class='app-name'>Finder</div><div class='app-desc'>v2.0.0</div></div>\n          <span class='badge'>Системное</span>\n        </div>\n        <div class='installed-item'>\n          <div class='app-icon-sm' style='background:linear-gradient(135deg,#3b82f6,#4f46e5)'><span class='material-icons'>store</span></div>\n          <div class='app-info'><div class='app-name'>App Store</div><div class='app-desc'>v2.0.0</div></div>\n          <span class='badge'>Системное</span>\n        </div>\n      </div>\n    </div>\n    <div id='section-updates' class='section'>\n      <h3 class='section-title'>Обновления</h3>\n      <div class='empty-state'>\n        <span class='material-icons'>check_circle</span>\n        <p>Все приложения обновлены</p>\n      </div>\n    </div>\n  </main>\n</div>\n<style>\n.store-root {\n  display: flex;\n  height: 100vh;\n  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;\n  overflow: hidden;\n  background: #1e1e1e;\n  color: #f5f5f7;\n}\n\n.sidebar {\n  width: 200px;\n  padding: 16px 10px;\n  background: #2a2a2a;\n  border-right: 1px solid rgba(255, 255, 255, 0.05);\n  flex-shrink: 0;\n  display: flex;\n  flex-direction: column;\n}\n\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 12px;\n  margin-bottom: 16px;\n  font-weight: 700;\n  font-size: 16px;\n  color: #f5f5f7;\n}\n\n.logo .material-icons {\n  color: #007aff;\n}\n\n.nav {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  margin-bottom: 20px;\n}\n\n.nav-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 12px;\n  border-radius: 8px;\n  cursor: pointer;\n  font-size: 13px;\n  transition: 0.15s;\n  opacity: 0.7;\n  color: #f5f5f7;\n}\n\n.nav-item:hover {\n  opacity: 1;\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.nav-item.active {\n  opacity: 1;\n  background: rgba(0, 122, 255, 0.15);\n  color: #007aff;\n}\n\n.nav-item .material-icons {\n  font-size: 18px;\n}\n\n.drop-zone {\n  margin-top: auto;\n  padding: 20px;\n  text-align: center;\n  border-radius: 12px;\n  border: 2px dashed rgba(0, 122, 255, 0.3);\n  transition: 0.2s;\n}\n\n.drop-zone:hover,\n.drop-zone.dragover {\n  border-color: #007aff;\n  background: rgba(0, 122, 255, 0.05);\n}\n\n.drop-zone .material-icons {\n  font-size: 32px;\n  color: #007aff;\n  margin-bottom: 8px;\n  display: block;\n}\n\n.drop-zone p {\n  font-size: 11px;\n  opacity: 0.7;\n  margin: 0;\n  color: #f5f5f7;\n}\n\n.main {\n  flex: 1;\n  overflow-y: auto;\n  padding: 20px;\n}\n\n.section {\n  display: none;\n  animation: fadeIn 0.3s ease;\n}\n\n.section.active {\n  display: block;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.banner {\n  display: flex;\n  align-items: center;\n  padding: 24px;\n  border-radius: 16px;\n  margin-bottom: 24px;\n  gap: 20px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.banner-content {\n  flex: 1;\n}\n\n.banner-content h2 {\n  font-size: 22px;\n  margin: 0 0 8px;\n  color: #f5f5f7;\n}\n\n.banner-content p {\n  font-size: 14px;\n  opacity: 0.7;\n  margin: 0 0 16px;\n  color: #f5f5f7;\n}\n\n.banner-icon {\n  width: 80px;\n  height: 80px;\n  background: linear-gradient(135deg, #007aff, #5856d6);\n  border-radius: 20px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.banner-icon .material-icons {\n  font-size: 40px;\n  color: white;\n}\n\n.btn-primary {\n  background: #007aff;\n  color: white;\n  border: none;\n  padding: 8px 20px;\n  border-radius: 20px;\n  font-size: 13px;\n  font-weight: 600;\n  cursor: pointer;\n  transition: 0.2s;\n}\n\n.btn-primary:hover {\n  background: #0056b3;\n}\n\n.btn-primary:disabled {\n  background: #34c759;\n  cursor: default;\n}\n\n.btn-primary.small {\n  padding: 6px 14px;\n  font-size: 12px;\n}\n\n.section-title {\n  font-size: 18px;\n  font-weight: 600;\n  margin: 0 0 16px;\n  color: #f5f5f7;\n}\n\n.app-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 12px;\n}\n\n.app-card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.app-icon {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.app-icon .material-icons {\n  color: white;\n  font-size: 24px;\n}\n\n.app-info {\n  flex: 1;\n  min-width: 0;\n}\n\n.app-name {\n  font-size: 14px;\n  font-weight: 600;\n  color: #f5f5f7;\n}\n\n.app-desc {\n  font-size: 12px;\n  opacity: 0.6;\n  color: #f5f5f7;\n}\n\n.categories-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: 12px;\n}\n\n.category-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  padding: 24px;\n  border-radius: 12px;\n  cursor: pointer;\n  transition: 0.2s;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  color: #f5f5f7;\n}\n\n.category-card:hover {\n  transform: translateY(-2px);\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.category-card .material-icons {\n  font-size: 32px;\n  color: #007aff;\n}\n\n.installed-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.installed-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px;\n  border-radius: 12px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.app-icon-sm {\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.app-icon-sm .material-icons {\n  color: white;\n  font-size: 20px;\n}\n\n.badge {\n  font-size: 11px;\n  padding: 3px 8px;\n  background: rgba(0, 122, 255, 0.15);\n  color: #007aff;\n  border-radius: 10px;\n}\n\n.empty-state {\n  text-align: center;\n  padding: 40px;\n  opacity: 0.5;\n  color: #f5f5f7;\n}\n\n.empty-state .material-icons {\n  font-size: 48px;\n  color: #34c759;\n  margin-bottom: 12px;\n  display: block;\n}\n\n.notification {\n  position: fixed;\n  top: 20px;\n  right: 20px;\n  background: rgba(52, 199, 89, 0.95);\n  color: white;\n  padding: 12px 20px;\n  border-radius: 12px;\n  font-size: 13px;\n  font-weight: 500;\n  z-index: 10000;\n  backdrop-filter: blur(20px);\n  box-shadow: 0 4px 24px rgba(0, 0, 0, 0.2);\n  animation: slideIn 0.3s ease;\n}\n\n@keyframes slideIn {\n  from { transform: translateX(100%); opacity: 0; }\n  to { transform: translateX(0); opacity: 1; }\n}\n\n@keyframes slideOut {\n  from { transform: translateX(0); opacity: 1; }\n  to { transform: translateX(100%); opacity: 0; }\n}\n</style>\n<script>\nfunction showSection(id) {\n  document.querySelectorAll('.section').forEach(function(s) { s.classList.remove('active'); });\n  document.getElementById('section-' + id).classList.add('active');\n  document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });\n  event.target.closest('.nav-item').classList.add('active');\n}\n\nfunction installApp(appId) {\n  var btn = event.target;\n  \n  var appData = {\n    id: appId + '_installed',\n    name: getAppName(appId),\n    icon: getAppIcon(appId),\n    color: getAppColor(appId),\n    version: '1.0.0',\n    author: 'App Store User',\n    description: 'Installed from App Store',\n    eappVersion: '1.1',\n    background: '#1e1e1e',\n    code: getPlaceholderCode(appId)\n  };\n  \n  window.parent.postMessage({\n    type: 'eapp-install-from-file',\n    app: appData\n  }, '*');\n  \n  btn.textContent = 'Установлено';\n  btn.disabled = true;\n  \n  showNotification('Приложение \"' + appData.name + '\" установлено');\n}\n\nfunction getAppName(appId) {\n  var names = {\n    'calculator': 'Калькулятор Pro',\n    'paint': 'eOS Paint',\n    'codeeditor': 'Code Editor',\n    'music': 'Music Player',\n    'weather': 'Weather',\n    'photos': 'Photos',\n    'games': 'eOS Games'\n  };\n  return names[appId] || appId;\n}\n\nfunction getAppIcon(appId) {\n  var icons = {\n    'calculator': 'material:calculate',\n    'paint': 'material:brush',\n    'codeeditor': 'material:code',\n    'music': 'material:music_note',\n    'weather': 'material:cloud',\n    'photos': 'material:photo_camera',\n    'games': 'material:games'\n  };\n  return icons[appId] || 'material:apps';\n}\n\nfunction getAppColor(appId) {\n  var colors = {\n    'calculator': 'from-orange-500 to-red-500',\n    'paint': 'from-purple-500 to-pink-500',\n    'codeeditor': 'from-green-500 to-teal-500',\n    'music': 'from-orange-500 to-red-500',\n    'weather': 'from-cyan-500 to-blue-500',\n    'photos': 'from-yellow-500 to-orange-500',\n    'games': 'from-indigo-500 to-purple-500'\n  };\n  return colors[appId] || 'from-gray-500 to-gray-700';\n}\n\nfunction getPlaceholderCode(appId) {\n  return '<div style=\"display:flex;align-items:center;justify-content:center;height:100%;font-family:-apple-system,sans-serif;background:#1e1e1e;color:#f5f5f7;\"><div style=\"text-align:center;\"><span class=\"material-icons\" style=\"font-size:64px;opacity:0.3;margin-bottom:16px;display:block;\">' + getAppIcon(appId).replace('material:', '') + '</span><h2 style=\"margin:0 0 8px;font-size:24px;\">' + getAppName(appId) + '</h2><p style=\"margin:0;opacity:0.6;\">Приложение из App Store</p></div></div>';\n}\n\nfunction showNotification(message) {\n  var notification = document.createElement('div');\n  notification.className = 'notification';\n  notification.textContent = message;\n  document.body.appendChild(notification);\n  \n  setTimeout(function() {\n    notification.style.animation = 'slideOut 0.3s ease';\n    setTimeout(function() {\n      if (notification.parentNode) {\n        document.body.removeChild(notification);\n      }\n    }, 300);\n  }, 3000);\n}\n\n// Drag & Drop support\nvar dropZone = document.querySelector('.drop-zone');\nif (dropZone) {\n  dropZone.addEventListener('dragover', function(e) {\n    e.preventDefault();\n    e.stopPropagation();\n    dropZone.classList.add('dragover');\n  });\n  \n  dropZone.addEventListener('dragleave', function(e) {\n    e.preventDefault();\n    e.stopPropagation();\n    dropZone.classList.remove('dragover');\n  });\n  \n  dropZone.addEventListener('drop', function(e) {\n    e.preventDefault();\n    e.stopPropagation();\n    dropZone.classList.remove('dragover');\n    \n    var files = e.dataTransfer.files;\n    for (var i = 0; i < files.length; i++) {\n      var file = files[i];\n      if (file.name.endsWith('.eapp')) {\n        var reader = new FileReader();\n        reader.onload = function(ev) {\n          try {\n            var appData = JSON.parse(ev.target.result);\n            window.parent.postMessage({\n              type: 'eapp-install-from-file',\n              app: appData\n            }, '*');\n            showNotification('Приложение \"' + appData.name + '\" установлено');\n          } catch (err) {\n            alert('Ошибка: неверный формат .eapp файла');\n          }\n        };\n        reader.readAsText(file);\n      }\n    }\n  });\n}\n</script>"
}
