{
  "id": "textedit_desktop",
  "name": "TextEdit",
  "icon": "material:edit_note",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/textedit-2025-11-14/1024.png&w=512",
  "color": "from-blue-400 to-blue-600",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Simple Text Editor",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='editor-root'>\n  <div class='toolbar'>\n    <button class='tool-btn' onclick='newFile()'><span class='material-icons'>note_add</span></button>\n    <button class='tool-btn' onclick='openFile()'><span class='material-icons'>folder_open</span></button>\n    <button class='tool-btn' onclick='saveFile()'><span class='material-icons'>save</span></button>\n    <div class='separator'></div>\n    <button class='tool-btn' onclick='formatBold()'><span class='material-icons'>format_bold</span></button>\n    <button class='tool-btn' onclick='formatItalic()'><span class='material-icons'>format_italic</span></button>\n    <div class='separator'></div>\n    <select class='font-select' onchange='changeFont(this.value)'>\n      <option value='monospace'>Monospace</option>\n      <option value='sans-serif'>Sans-serif</option>\n      <option value='serif'>Serif</option>\n    </select>\n    <select class='font-select' onchange='changeSize(this.value)'>\n      <option value='12'>12px</option>\n      <option value='14' selected>14px</option>\n      <option value='16'>16px</option>\n      <option value='18'>18px</option>\n      <option value='24'>24px</option>\n    </select>\n    <div class='file-name' id='fileName'>Без названия</div>\n  </div>\n  <textarea class='editor-area' id='editorArea' placeholder='Начните вводить текст...' spellcheck='false'></textarea>\n  <div class='status-bar'>\n    <span id='charCount'>0 символов</span>\n    <span id='lineCount'>1 строка</span>\n    <span id='wordCount'>0 слов</span>\n  </div>\n</div>\n<style>\n.editor-root { height: 100vh; display: flex; flex-direction: column; font-family: -apple-system, sans-serif; background: #1e1e1e; color: #f5f5f7; }\n.toolbar { display: flex; align-items: center; gap: 4px; padding: 8px 12px; background: #2a2a2a; border-bottom: 1px solid rgba(255,255,255,0.1); }\n.tool-btn { background: transparent; border: none; color: #f5f5f7; padding: 6px; border-radius: 6px; cursor: pointer; opacity: 0.7; transition: 0.15s; }\n.tool-btn:hover { opacity: 1; background: rgba(255,255,255,0.1); }\n.tool-btn .material-icons { font-size: 18px; }\n.separator { width: 1px; height: 20px; background: rgba(255,255,255,0.1); margin: 0 4px; }\n.font-select { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #f5f5f7; padding: 4px 8px; border-radius: 6px; font-size: 12px; outline: none; }\n.file-name { margin-left: auto; font-size: 12px; opacity: 0.6; }\n.editor-area { flex: 1; background: #1e1e1e; border: none; color: #f5f5f7; padding: 20px; font-family: monospace; font-size: 14px; line-height: 1.6; resize: none; outline: none; tab-size: 4; }\n.status-bar { display: flex; gap: 16px; padding: 6px 12px; background: #2a2a2a; border-top: 1px solid rgba(255,255,255,0.1); font-size: 11px; opacity: 0.6; }\n</style>\n<script>\nvar editor = document.getElementById('editorArea');\nvar currentFile = null;\n\neditor.addEventListener('input', updateStats);\n\nfunction updateStats() {\n  var text = editor.value;\n  document.getElementById('charCount').textContent = text.length + ' символов';\n  document.getElementById('lineCount').textContent = text.split('\\n').length + ' строк';\n  var words = text.trim() ? text.trim().split(/\\s+/).length : 0;\n  document.getElementById('wordCount').textContent = words + ' слов';\n}\n\nfunction newFile() {\n  if (editor.value && !confirm('Создать новый файл? Несохранённые изменения будут потеряны.')) return;\n  editor.value = '';\n  currentFile = null;\n  document.getElementById('fileName').textContent = 'Без названия';\n  updateStats();\n}\n\nfunction saveFile() {\n  var name = prompt('Имя файла:', currentFile || 'document.txt');\n  if (!name) return;\n  currentFile = name;\n  document.getElementById('fileName').textContent = name;\n  \n  // Save to virtual FS\n  var files = JSON.parse(localStorage.getItem('eos_textedit_files') || '{}');\n  files[name] = { content: editor.value, modified: Date.now() };\n  localStorage.setItem('eos_textedit_files', JSON.stringify(files));\n  \n  alert('Файл \"' + name + '\" сохранён');\n}\n\nfunction openFile() {\n  var files = JSON.parse(localStorage.getItem('eos_textedit_files') || '{}');\n  var names = Object.keys(files);\n  if (names.length === 0) {\n    alert('Нет сохранённых файлов');\n    return;\n  }\n  var name = prompt('Открыть файл:\\n' + names.join('\\n') + '\\n\\nВведите имя:');\n  if (name && files[name]) {\n    editor.value = files[name].content;\n    currentFile = name;\n    document.getElementById('fileName').textContent = name;\n    updateStats();\n  }\n}\n\nfunction formatBold() {\n  // Simple toggle for demo\n  editor.style.fontWeight = editor.style.fontWeight === 'bold' ? 'normal' : 'bold';\n}\n\nfunction formatItalic() {\n  editor.style.fontStyle = editor.style.fontStyle === 'italic' ? 'normal' : 'italic';\n}\n\nfunction changeFont(font) {\n  editor.style.fontFamily = font;\n}\n\nfunction changeSize(size) {\n  editor.style.fontSize = size + 'px';\n}\n\n// Tab key support\neditor.addEventListener('keydown', function(e) {\n  if (e.key === 'Tab') {\n    e.preventDefault();\n    var start = this.selectionStart;\n    var end = this.selectionEnd;\n    this.value = this.value.substring(0, start) + '    ' + this.value.substring(end);\n    this.selectionStart = this.selectionEnd = start + 4;\n  }\n});\n\nupdateStats();\n</script>"
}
