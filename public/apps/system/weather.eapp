{
  "id": "weather_desktop",
  "name": "Погода",
  "icon": "material:cloud",
  "color": "from-blue-400 to-cyan-500",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Weather application with Open-Meteo API",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "linear-gradient(135deg, #667eea 0%, #764ba2 100%)",
  "code": "<div class='weather-root'>\n  <div class='weather-header'>\n    <div class='location'>\n      <span class='material-icons'>location_on</span>\n      <span id='cityName'>Определение местоположения...</span>\n    </div>\n    <button class='refresh-btn' onclick='refreshWeather()'>\n      <span class='material-icons'>refresh</span>\n    </button>\n  </div>\n\n  <div class='current-weather'>\n    <div class='temp-container'>\n      <div class='weather-icon' id='currentIcon'>\n        <span class='material-icons'>cloud</span>\n      </div>\n      <div class='temperature' id='currentTemp'>--°</div>\n      <div class='description' id='currentDesc'>Загрузка...</div>\n    </div>\n    <div class='details'>\n      <div class='detail-item'>\n        <span class='material-icons'>thermostat</span>\n        <div>\n          <div class='detail-label'>Ощущается</div>\n          <div class='detail-value' id='feelsLike'>--°</div>\n        </div>\n      </div>\n      <div class='detail-item'>\n        <span class='material-icons'>air</span>\n        <div>\n          <div class='detail-label'>Ветер</div>\n          <div class='detail-value' id='windSpeed'>-- м/с</div>\n        </div>\n      </div>\n      <div class='detail-item'>\n        <span class='material-icons'>water_drop</span>\n        <div>\n          <div class='detail-label'>Влажность</div>\n          <div class='detail-value' id='humidity'>--%</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class='forecast-section'>\n    <h3>Прогноз на 7 дней</h3>\n    <div class='forecast-grid' id='forecastGrid'>\n      <div class='loading'>Загрузка прогноза...</div>\n    </div>\n  </div>\n\n  <div class='hourly-section'>\n    <h3>Почасовой прогноз</h3>\n    <div class='hourly-scroll' id='hourlyScroll'>\n      <div class='loading'>Загрузка...</div>\n    </div>\n  </div>\n</div>\n\n<style>\n.weather-root {\n  height: 100vh;\n  overflow-y: auto;\n  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;\n  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\n  color: white;\n  padding: 20px;\n}\n\n.weather-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 30px;\n}\n\n.location {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 18px;\n  font-weight: 500;\n}\n\n.refresh-btn {\n  background: rgba(255, 255, 255, 0.2);\n  border: none;\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: 0.2s;\n  color: white;\n}\n\n.refresh-btn:hover {\n  background: rgba(255, 255, 255, 0.3);\n  transform: rotate(180deg);\n}\n\n.current-weather {\n  text-align: center;\n  margin-bottom: 40px;\n}\n\n.temp-container {\n  margin-bottom: 30px;\n}\n\n.weather-icon {\n  font-size: 80px;\n  margin-bottom: 10px;\n  opacity: 0.9;\n}\n\n.temperature {\n  font-size: 72px;\n  font-weight: 200;\n  line-height: 1;\n  margin-bottom: 10px;\n}\n\n.description {\n  font-size: 20px;\n  opacity: 0.9;\n  text-transform: capitalize;\n}\n\n.details {\n  display: flex;\n  justify-content: center;\n  gap: 40px;\n  margin-top: 30px;\n}\n\n.detail-item {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.detail-item .material-icons {\n  font-size: 32px;\n  opacity: 0.8;\n}\n\n.detail-label {\n  font-size: 12px;\n  opacity: 0.7;\n  margin-bottom: 2px;\n}\n\n.detail-value {\n  font-size: 18px;\n  font-weight: 500;\n}\n\n.forecast-section,\n.hourly-section {\n  margin-bottom: 30px;\n}\n\n.forecast-section h3,\n.hourly-section h3 {\n  font-size: 16px;\n  font-weight: 600;\n  margin: 0 0 15px;\n  opacity: 0.9;\n}\n\n.forecast-grid {\n  display: grid;\n  grid-template-columns: repeat(7, 1fr);\n  gap: 10px;\n}\n\n.forecast-day {\n  background: rgba(255, 255, 255, 0.15);\n  backdrop-filter: blur(10px);\n  border-radius: 12px;\n  padding: 15px 10px;\n  text-align: center;\n  transition: 0.2s;\n}\n\n.forecast-day:hover {\n  background: rgba(255, 255, 255, 0.25);\n  transform: translateY(-2px);\n}\n\n.forecast-day .day-name {\n  font-size: 12px;\n  opacity: 0.8;\n  margin-bottom: 8px;\n}\n\n.forecast-day .day-icon {\n  font-size: 32px;\n  margin: 8px 0;\n}\n\n.forecast-day .day-temp {\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.forecast-day .day-temp-min {\n  font-size: 14px;\n  opacity: 0.6;\n  margin-top: 4px;\n}\n\n.hourly-scroll {\n  display: flex;\n  gap: 12px;\n  overflow-x: auto;\n  padding-bottom: 10px;\n}\n\n.hourly-item {\n  background: rgba(255, 255, 255, 0.15);\n  backdrop-filter: blur(10px);\n  border-radius: 12px;\n  padding: 15px;\n  min-width: 80px;\n  text-align: center;\n  flex-shrink: 0;\n  transition: 0.2s;\n}\n\n.hourly-item:hover {\n  background: rgba(255, 255, 255, 0.25);\n}\n\n.hourly-item .hour-time {\n  font-size: 12px;\n  opacity: 0.8;\n  margin-bottom: 8px;\n}\n\n.hourly-item .hour-icon {\n  font-size: 28px;\n  margin: 8px 0;\n}\n\n.hourly-item .hour-temp {\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.loading {\n  text-align: center;\n  padding: 20px;\n  opacity: 0.7;\n}\n\n.error {\n  background: rgba(255, 59, 48, 0.2);\n  border-radius: 12px;\n  padding: 20px;\n  text-align: center;\n}\n\n.error .material-icons {\n  font-size: 48px;\n  margin-bottom: 10px;\n}\n</style>\n\n<script>\nvar weatherData = null;\nvar userLocation = null;\n\n// Weather code to icon mapping\nvar weatherIcons = {\n  0: 'clear_day',\n  1: 'partly_cloudy_day',\n  2: 'cloud',\n  3: 'cloud',\n  45: 'foggy',\n  48: 'foggy',\n  51: 'grain',\n  53: 'grain',\n  55: 'grain',\n  61: 'rainy',\n  63: 'rainy',\n  65: 'rainy',\n  71: 'weather_snowy',\n  73: 'weather_snowy',\n  75: 'weather_snowy',\n  80: 'rainy',\n  81: 'rainy',\n  82: 'rainy',\n  95: 'thunderstorm',\n  96: 'thunderstorm',\n  99: 'thunderstorm'\n};\n\nvar weatherDescriptions = {\n  0: 'Ясно',\n  1: 'Преимущественно ясно',\n  2: 'Переменная облачность',\n  3: 'Пасмурно',\n  45: 'Туман',\n  48: 'Иней',\n  51: 'Лёгкая морось',\n  53: 'Морось',\n  55: 'Сильная морось',\n  61: 'Небольшой дождь',\n  63: 'Дождь',\n  65: 'Сильный дождь',\n  71: 'Небольшой снег',\n  73: 'Снег',\n  75: 'Сильный снег',\n  80: 'Ливень',\n  81: 'Сильный ливень',\n  82: 'Очень сильный ливень',\n  95: 'Гроза',\n  96: 'Гроза с градом',\n  99: 'Сильная гроза с градом'\n};\n\nfunction getLocation() {\n  if ('geolocation' in navigator) {\n    navigator.geolocation.getCurrentPosition(\n      function(position) {\n        userLocation = {\n          lat: position.coords.latitude,\n          lon: position.coords.longitude\n        };\n        fetchWeather();\n        reverseGeocode();\n      },\n      function(error) {\n        console.error('Geolocation error:', error);\n        // Default to Moscow\n        userLocation = { lat: 55.7558, lon: 37.6173 };\n        fetchWeather();\n        document.getElementById('cityName').textContent = 'Москва';\n      }\n    );\n  } else {\n    // Default to Moscow\n    userLocation = { lat: 55.7558, lon: 37.6173 };\n    fetchWeather();\n    document.getElementById('cityName').textContent = 'Москва';\n  }\n}\n\nfunction reverseGeocode() {\n  fetch('https://geocoding-api.open-meteo.com/v1/search?name=' + userLocation.lat + ',' + userLocation.lon + '&count=1')\n    .then(response => response.json())\n    .then(data => {\n      if (data.results && data.results.length > 0) {\n        document.getElementById('cityName').textContent = data.results[0].name;\n      }\n    })\n    .catch(err => {\n      console.error('Geocoding error:', err);\n    });\n}\n\nfunction fetchWeather() {\n  if (!userLocation) return;\n\n  var url = 'https://api.open-meteo.com/v1/forecast?latitude=' + userLocation.lat + \n            '&longitude=' + userLocation.lon + \n            '&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m' +\n            '&hourly=temperature_2m,weather_code' +\n            '&daily=weather_code,temperature_2m_max,temperature_2m_min' +\n            '&timezone=auto';\n\n  fetch(url)\n    .then(response => response.json())\n    .then(data => {\n      weatherData = data;\n      updateUI();\n    })\n    .catch(err => {\n      console.error('Weather fetch error:', err);\n      showError();\n    });\n}\n\nfunction updateUI() {\n  if (!weatherData) return;\n\n  var current = weatherData.current;\n  var weatherCode = current.weather_code;\n\n  // Current weather\n  document.getElementById('currentIcon').innerHTML = '<span class=\"material-icons\">' + (weatherIcons[weatherCode] || 'cloud') + '</span>';\n  document.getElementById('currentTemp').textContent = Math.round(current.temperature_2m) + '°';\n  document.getElementById('currentDesc').textContent = weatherDescriptions[weatherCode] || 'Неизвестно';\n  document.getElementById('feelsLike').textContent = Math.round(current.apparent_temperature) + '°';\n  document.getElementById('windSpeed').textContent = Math.round(current.wind_speed_10m * 1000 / 3600) + ' м/с';\n  document.getElementById('humidity').textContent = current.relative_humidity_2m + '%';\n\n  // Daily forecast\n  var forecastGrid = document.getElementById('forecastGrid');\n  var daily = weatherData.daily;\n  var forecastHTML = '';\n  \n  for (var i = 0; i < 7; i++) {\n    var date = new Date(daily.time[i]);\n    var dayName = date.toLocaleDateString('ru-RU', { weekday: 'short' });\n    var icon = weatherIcons[daily.weather_code[i]] || 'cloud';\n    var tempMax = Math.round(daily.temperature_2m_max[i]);\n    var tempMin = Math.round(daily.temperature_2m_min[i]);\n    \n    forecastHTML += '<div class=\"forecast-day\">' +\n      '<div class=\"day-name\">' + dayName + '</div>' +\n      '<div class=\"day-icon\"><span class=\"material-icons\">' + icon + '</span></div>' +\n      '<div class=\"day-temp\">' + tempMax + '°</div>' +\n      '<div class=\"day-temp-min\">' + tempMin + '°</div>' +\n    '</div>';\n  }\n  \n  forecastGrid.innerHTML = forecastHTML;\n\n  // Hourly forecast\n  var hourlyScroll = document.getElementById('hourlyScroll');\n  var hourly = weatherData.hourly;\n  var hourlyHTML = '';\n  var currentHour = new Date().getHours();\n  \n  for (var i = currentHour; i < currentHour + 24; i++) {\n    var time = new Date(hourly.time[i]);\n    var hourStr = time.getHours().toString().padStart(2, '0') + ':00';\n    var icon = weatherIcons[hourly.weather_code[i]] || 'cloud';\n    var temp = Math.round(hourly.temperature_2m[i]);\n    \n    hourlyHTML += '<div class=\"hourly-item\">' +\n      '<div class=\"hour-time\">' + hourStr + '</div>' +\n      '<div class=\"hour-icon\"><span class=\"material-icons\">' + icon + '</span></div>' +\n      '<div class=\"hour-temp\">' + temp + '°</div>' +\n    '</div>';\n  }\n  \n  hourlyScroll.innerHTML = hourlyHTML;\n}\n\nfunction showError() {\n  document.getElementById('forecastGrid').innerHTML = '<div class=\"error\"><span class=\"material-icons\">error</span><p>Ошибка загрузки данных</p></div>';\n  document.getElementById('hourlyScroll').innerHTML = '<div class=\"error\">Не удалось загрузить прогноз</div>';\n}\n\nfunction refreshWeather() {\n  document.getElementById('forecastGrid').innerHTML = '<div class=\"loading\">Обновление...</div>';\n  document.getElementById('hourlyScroll').innerHTML = '<div class=\"loading\">Обновление...</div>';\n  getLocation();\n}\n\n// Initialize\ngetLocation();\n</script>"
}
