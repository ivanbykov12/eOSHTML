{
  "id": "sysmonitor_desktop",
  "name": "Мониторинг",
  "icon": "material:monitor_heart",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/activity-monitor-2026-09-23/1024.png&w=512",
  "color": "from-green-500 to-emerald-600",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "System Resource Monitor",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='monitor-root'>\n  <div class='monitor-header'>\n    <h2>Системный мониторинг</h2>\n    <div class='refresh-info'>Обновление: 1с</div>\n  </div>\n  \n  <div class='stats-grid'>\n    <div class='stat-card'>\n      <div class='stat-icon cpu'><span class='material-icons'>memory</span></div>\n      <div class='stat-info'>\n        <div class='stat-label'>CPU</div>\n        <div class='stat-value' id='cpuVal'>0%</div>\n        <div class='stat-bar'><div class='stat-bar-fill' id='cpuBar' style='width:0%'></div></div>\n      </div>\n    </div>\n    \n    <div class='stat-card'>\n      <div class='stat-icon ram'><span class='material-icons'>dns</span></div>\n      <div class='stat-info'>\n        <div class='stat-label'>RAM</div>\n        <div class='stat-value' id='ramVal'>0 / 18 ГБ</div>\n        <div class='stat-bar'><div class='stat-bar-fill' id='ramBar' style='width:0%'></div></div>\n      </div>\n    </div>\n    \n    <div class='stat-card'>\n      <div class='stat-icon disk'><span class='material-icons'>storage</span></div>\n      <div class='stat-info'>\n        <div class='stat-label'>Диск</div>\n        <div class='stat-value' id='diskVal'>0 / 256 ГБ</div>\n        <div class='stat-bar'><div class='stat-bar-fill' id='diskBar' style='width:0%'></div></div>\n      </div>\n    </div>\n    \n    <div class='stat-card'>\n      <div class='stat-icon net'><span class='material-icons'>wifi</span></div>\n      <div class='stat-info'>\n        <div class='stat-label'>Сеть</div>\n        <div class='stat-value' id='netVal'>0 МБ/с</div>\n        <div class='stat-bar'><div class='stat-bar-fill' id='netBar' style='width:0%'></div></div>\n      </div>\n    </div>\n  </div>\n  \n  <div class='processes-section'>\n    <h3>Активные процессы</h3>\n    <div class='process-list' id='processList'></div>\n  </div>\n  \n  <div class='uptime-section'>\n    <div class='uptime-item'>\n      <span class='material-icons'>schedule</span>\n      <div>\n        <div class='uptime-label'>Время работы</div>\n        <div class='uptime-value' id='uptime'>0ч 0м</div>\n      </div>\n    </div>\n    <div class='uptime-item'>\n      <span class='material-icons'>thermostat</span>\n      <div>\n        <div class='uptime-label'>Температура CPU</div>\n        <div class='uptime-value' id='temp'>45°C</div>\n      </div>\n    </div>\n    <div class='uptime-item'>\n      <span class='material-icons'>battery_full</span>\n      <div>\n        <div class='uptime-label'>Батарея</div>\n        <div class='uptime-value' id='battery'>100%</div>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n.monitor-root { height: 100vh; display: flex; flex-direction: column; font-family: -apple-system, sans-serif; background: #1e1e1e; color: #f5f5f7; padding: 20px; overflow-y: auto; }\n.monitor-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }\n.monitor-header h2 { margin: 0; font-size: 20px; font-weight: 600; }\n.refresh-info { font-size: 11px; opacity: 0.5; }\n.stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: 20px; }\n.stat-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 16px; display: flex; gap: 12px; align-items: center; }\n.stat-icon { width: 40px; height: 40px; border-radius: 10px; display: flex; align-items: center; justify-content: center; }\n.stat-icon.cpu { background: linear-gradient(135deg, #ff6b6b, #ee5a6f); }\n.stat-icon.ram { background: linear-gradient(135deg, #4ecdc4, #44a08d); }\n.stat-icon.disk { background: linear-gradient(135deg, #f093fb, #f5576c); }\n.stat-icon.net { background: linear-gradient(135deg, #4facfe, #00f2fe); }\n.stat-icon .material-icons { color: white; font-size: 20px; }\n.stat-info { flex: 1; }\n.stat-label { font-size: 11px; opacity: 0.6; margin-bottom: 2px; }\n.stat-value { font-size: 14px; font-weight: 500; margin-bottom: 6px; }\n.stat-bar { height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }\n.stat-bar-fill { height: 100%; background: linear-gradient(90deg, #007aff, #5ac8fa); border-radius: 2px; transition: width 0.5s ease; }\n.processes-section { margin-bottom: 20px; }\n.processes-section h3 { font-size: 14px; font-weight: 600; margin: 0 0 12px; }\n.process-list { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; overflow: hidden; }\n.process-item { display: flex; align-items: center; padding: 10px 16px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 12px; }\n.process-item:last-child { border-bottom: none; }\n.process-name { flex: 1; }\n.process-cpu { width: 60px; text-align: right; opacity: 0.7; }\n.process-mem { width: 80px; text-align: right; opacity: 0.7; }\n.uptime-section { display: flex; gap: 16px; }\n.uptime-item { flex: 1; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 16px; display: flex; align-items: center; gap: 12px; }\n.uptime-item .material-icons { font-size: 24px; opacity: 0.6; }\n.uptime-label { font-size: 11px; opacity: 0.6; }\n.uptime-value { font-size: 14px; font-weight: 500; }\n</style>\n<script>\nvar startTime = Date.now();\n\nvar processes = [\n  { name: 'WindowServer', cpu: 12, mem: 245 },\n  { name: 'kernel_task', cpu: 8, mem: 1024 },\n  { name: 'Finder', cpu: 3, mem: 89 },\n  { name: 'Safari', cpu: 15, mem: 512 },\n  { name: 'Spotlight', cpu: 2, mem: 67 },\n  { name: 'SystemUIServer', cpu: 1, mem: 45 },\n  { name: 'mds', cpu: 4, mem: 123 },\n  { name: 'loginwindow', cpu: 0, mem: 34 }\n];\n\nfunction updateStats() {\n  // CPU (simulated)\n  var cpu = Math.floor(Math.random() * 30) + 10;\n  document.getElementById('cpuVal').textContent = cpu + '%';\n  document.getElementById('cpuBar').style.width = cpu + '%';\n  \n  // RAM (simulated)\n  var ramUsed = (Math.random() * 4 + 6).toFixed(1);\n  document.getElementById('ramVal').textContent = ramUsed + ' / 18 ГБ';\n  document.getElementById('ramBar').style.width = (ramUsed / 18 * 100) + '%';\n  \n  // Disk\n  var diskUsed = 42;\n  document.getElementById('diskVal').textContent = diskUsed + ' / 256 ГБ';\n  document.getElementById('diskBar').style.width = (diskUsed / 256 * 100) + '%';\n  \n  // Network\n  var netSpeed = (Math.random() * 5).toFixed(1);\n  document.getElementById('netVal').textContent = netSpeed + ' МБ/с';\n  document.getElementById('netBar').style.width = (netSpeed / 10 * 100) + '%';\n  \n  // Processes\n  var processHtml = processes.map(function(p) {\n    var pCpu = Math.max(0, p.cpu + Math.floor(Math.random() * 5) - 2);\n    return '<div class=\"process-item\">' +\n      '<span class=\"process-name\">' + p.name + '</span>' +\n      '<span class=\"process-cpu\">' + pCpu + '%</span>' +\n      '<span class=\"process-mem\">' + p.mem + ' МБ</span>' +\n    '</div>';\n  }).join('');\n  document.getElementById('processList').innerHTML = processHtml;\n  \n  // Uptime\n  var elapsed = Math.floor((Date.now() - startTime) / 1000);\n  var hours = Math.floor(elapsed / 3600);\n  var mins = Math.floor((elapsed % 3600) / 60);\n  document.getElementById('uptime').textContent = hours + 'ч ' + mins + 'м';\n  \n  // Temperature\n  var temp = Math.floor(40 + Math.random() * 15);\n  document.getElementById('temp').textContent = temp + '°C';\n  \n  // Battery\n  var battery = Math.floor(85 + Math.random() * 15);\n  document.getElementById('battery').textContent = battery + '%';\n}\n\nsetInterval(updateStats, 1000);\nupdateStats();\n</script>"
}
