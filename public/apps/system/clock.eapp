{
  "id": "clock_desktop",
  "name": "Часы",
  "icon": "material:schedule",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/clock-2025-11-13/1024.png&w=512",
  "color": "from-blue-500 to-cyan-500",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Clock and World Time",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='clock-root'>\n  <div class='clock-tabs'>\n    <button class='tab active' onclick=\"showTab('world')\">Мировое время</button>\n    <button class='tab' onclick=\"showTab('stopwatch')\">Секундомер</button>\n    <button class='tab' onclick=\"showTab('timer')\">Таймер</button>\n  </div>\n  \n  <div id='tab-world' class='tab-content active'>\n    <div class='main-clock'>\n      <div class='time-display' id='mainTime'>00:00:00</div>\n      <div class='date-display' id='mainDate'>Понедельник, 1 января</div>\n    </div>\n    <div class='world-clocks'>\n      <div class='world-clock'>\n        <div class='city'>Москва</div>\n        <div class='wc-time' id='msk'>00:00</div>\n      </div>\n      <div class='world-clock'>\n        <div class='city'>Нью-Йорк</div>\n        <div class='wc-time' id='nyc'>00:00</div>\n      </div>\n      <div class='world-clock'>\n        <div class='city'>Лондон</div>\n        <div class='wc-time' id='ldn'>00:00</div>\n      </div>\n      <div class='world-clock'>\n        <div class='city'>Токио</div>\n        <div class='wc-time' id='tky'>00:00</div>\n      </div>\n    </div>\n  </div>\n  \n  <div id='tab-stopwatch' class='tab-content'>\n    <div class='stopwatch-display' id='stopwatchDisplay'>00:00.00</div>\n    <div class='stopwatch-controls'>\n      <button class='sw-btn start' id='swStart' onclick='swToggle()'>Старт</button>\n      <button class='sw-btn reset' onclick='swReset()'>Сброс</button>\n    </div>\n  </div>\n  \n  <div id='tab-timer' class='tab-content'>\n    <div class='timer-setup' id='timerSetup'>\n      <div class='timer-inputs'>\n        <div class='timer-input-group'>\n          <input type='number' id='timerMin' min='0' max='99' value='5' class='timer-input'>\n          <span class='timer-label'>мин</span>\n        </div>\n        <span class='timer-sep'>:</span>\n        <div class='timer-input-group'>\n          <input type='number' id='timerSec' min='0' max='59' value='0' class='timer-input'>\n          <span class='timer-label'>сек</span>\n        </div>\n      </div>\n      <button class='sw-btn start' onclick='startTimer()'>Запустить</button>\n    </div>\n    <div class='timer-running' id='timerRunning' style='display:none;'>\n      <div class='stopwatch-display' id='timerDisplay'>05:00</div>\n      <div class='stopwatch-controls'>\n        <button class='sw-btn reset' onclick='cancelTimer()'>Отмена</button>\n      </div>\n    </div>\n  </div>\n</div>\n<style>\n.clock-root { height: 100vh; display: flex; flex-direction: column; font-family: -apple-system, sans-serif; background: #1e1e1e; color: #f5f5f7; padding: 20px; }\n.clock-tabs { display: flex; gap: 4px; margin-bottom: 30px; background: rgba(255,255,255,0.05); border-radius: 10px; padding: 4px; }\n.tab { flex: 1; padding: 10px; background: transparent; border: none; color: #f5f5f7; font-size: 13px; cursor: pointer; border-radius: 8px; opacity: 0.6; transition: 0.2s; }\n.tab:hover { opacity: 0.8; }\n.tab.active { background: rgba(0,122,255,0.2); opacity: 1; }\n.tab-content { display: none; flex: 1; }\n.tab-content.active { display: flex; flex-direction: column; }\n.main-clock { text-align: center; padding: 40px 0; }\n.time-display { font-size: 72px; font-weight: 200; letter-spacing: -2px; font-variant-numeric: tabular-nums; }\n.date-display { font-size: 16px; opacity: 0.6; margin-top: 8px; }\n.world-clocks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 20px; }\n.world-clock { background: rgba(255,255,255,0.05); border-radius: 12px; padding: 16px; border: 1px solid rgba(255,255,255,0.1); }\n.city { font-size: 13px; opacity: 0.7; margin-bottom: 4px; }\n.wc-time { font-size: 28px; font-weight: 300; font-variant-numeric: tabular-nums; }\n.stopwatch-display { font-size: 64px; font-weight: 200; text-align: center; padding: 60px 0; font-variant-numeric: tabular-nums; }\n.stopwatch-controls { display: flex; gap: 12px; justify-content: center; }\n.sw-btn { padding: 12px 32px; border-radius: 24px; border: none; font-size: 14px; font-weight: 500; cursor: pointer; transition: 0.2s; }\n.sw-btn.start { background: #34c759; color: white; }\n.sw-btn.start:hover { background: #2db84d; }\n.sw-btn.start.running { background: #ff3b30; }\n.sw-btn.reset { background: rgba(255,255,255,0.1); color: #f5f5f7; }\n.sw-btn.reset:hover { background: rgba(255,255,255,0.15); }\n.timer-setup { text-align: center; padding: 40px 0; }\n.timer-inputs { display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 30px; }\n.timer-input-group { display: flex; flex-direction: column; align-items: center; }\n.timer-input { width: 80px; font-size: 48px; font-weight: 200; text-align: center; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 12px; color: #f5f5f7; outline: none; }\n.timer-input:focus { border-color: #007aff; }\n.timer-label { font-size: 12px; opacity: 0.6; margin-top: 4px; }\n.timer-sep { font-size: 48px; font-weight: 200; opacity: 0.5; }\n.timer-running { flex: 1; display: flex; flex-direction: column; justify-content: center; }\n</style>\n<script>\n// World Clock\nfunction updateClocks() {\n  var now = new Date();\n  var h = String(now.getHours()).padStart(2, '0');\n  var m = String(now.getMinutes()).padStart(2, '0');\n  var s = String(now.getSeconds()).padStart(2, '0');\n  document.getElementById('mainTime').textContent = h + ':' + m + ':' + s;\n  \n  var days = ['Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота'];\n  var months = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];\n  document.getElementById('mainDate').textContent = days[now.getDay()] + ', ' + now.getDate() + ' ' + months[now.getMonth()];\n  \n  // World times\n  var utc = now.getTime() + now.getTimezoneOffset() * 60000;\n  var msk = new Date(utc + 3 * 3600000);\n  var nyc = new Date(utc - 5 * 3600000);\n  var ldn = new Date(utc + 0);\n  var tky = new Date(utc + 9 * 3600000);\n  \n  document.getElementById('msk').textContent = fmt(msk);\n  document.getElementById('nyc').textContent = fmt(nyc);\n  document.getElementById('ldn').textContent = fmt(ldn);\n  document.getElementById('tky').textContent = fmt(tky);\n}\n\nfunction fmt(d) {\n  return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');\n}\n\nsetInterval(updateClocks, 1000);\nupdateClocks();\n\n// Tabs\nfunction showTab(name) {\n  document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });\n  document.getElementById('tab-' + name).classList.add('active');\n  document.querySelectorAll('.tab').forEach(function(t) { t.classList.remove('active'); });\n  event.target.classList.add('active');\n}\n\n// Stopwatch\nvar swRunning = false;\nvar swTime = 0;\nvar swInterval = null;\n\nfunction swToggle() {\n  var btn = document.getElementById('swStart');\n  if (swRunning) {\n    clearInterval(swInterval);\n    btn.textContent = 'Старт';\n    btn.classList.remove('running');\n  } else {\n    swInterval = setInterval(function() {\n      swTime += 10;\n      var min = String(Math.floor(swTime / 60000)).padStart(2, '0');\n      var sec = String(Math.floor((swTime % 60000) / 1000)).padStart(2, '0');\n      var ms = String(Math.floor((swTime % 1000) / 10)).padStart(2, '0');\n      document.getElementById('stopwatchDisplay').textContent = min + ':' + sec + '.' + ms;\n    }, 10);\n    btn.textContent = 'Стоп';\n    btn.classList.add('running');\n  }\n  swRunning = !swRunning;\n}\n\nfunction swReset() {\n  clearInterval(swInterval);\n  swRunning = false;\n  swTime = 0;\n  document.getElementById('stopwatchDisplay').textContent = '00:00.00';\n  document.getElementById('swStart').textContent = 'Старт';\n  document.getElementById('swStart').classList.remove('running');\n}\n\n// Timer\nvar timerInterval = null;\nvar timerRemaining = 0;\n\nfunction startTimer() {\n  var min = parseInt(document.getElementById('timerMin').value) || 0;\n  var sec = parseInt(document.getElementById('timerSec').value) || 0;\n  timerRemaining = min * 60 + sec;\n  if (timerRemaining <= 0) return;\n  \n  document.getElementById('timerSetup').style.display = 'none';\n  document.getElementById('timerRunning').style.display = 'flex';\n  updateTimerDisplay();\n  \n  timerInterval = setInterval(function() {\n    timerRemaining--;\n    if (timerRemaining <= 0) {\n      clearInterval(timerInterval);\n      alert('Таймер завершён!');\n      cancelTimer();\n    } else {\n      updateTimerDisplay();\n    }\n  }, 1000);\n}\n\nfunction updateTimerDisplay() {\n  var min = String(Math.floor(timerRemaining / 60)).padStart(2, '0');\n  var sec = String(timerRemaining % 60).padStart(2, '0');\n  document.getElementById('timerDisplay').textContent = min + ':' + sec;\n}\n\nfunction cancelTimer() {\n  clearInterval(timerInterval);\n  document.getElementById('timerSetup').style.display = '';\n  document.getElementById('timerRunning').style.display = 'none';\n}\n</script>"
}
