{
  "id": "notes_desktop",
  "name": "Заметки",
  "icon": "material:note",
  "color": "from-yellow-400 to-orange-500",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Simple Notes Application",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='notes-root'>\n  <aside class='notes-sidebar'>\n    <div class='notes-header'>\n      <h3>Заметки</h3>\n      <button class='new-note-btn' onclick='createNote()'>\n        <span class='material-icons'>add</span>\n      </button>\n    </div>\n    <div class='notes-list' id='notesList'></div>\n  </aside>\n  <main class='notes-content'>\n    <div class='note-editor' id='noteEditor'>\n      <input type='text' class='note-title' id='noteTitle' placeholder='Заголовок' oninput='saveNote()'>\n      <textarea class='note-body' id='noteBody' placeholder='Начните писать...' oninput='saveNote()'></textarea>\n    </div>\n    <div class='empty-state' id='emptyState'>\n      <span class='material-icons'>note_add</span>\n      <p>Выберите заметку или создайте новую</p>\n    </div>\n  </main>\n</div>\n<style>\n.notes-root { display: flex; height: 100vh; font-family: -apple-system, sans-serif; background: #1e1e1e; color: #f5f5f7; }\n.notes-sidebar { width: 250px; background: #2a2a2a; border-right: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; }\n.notes-header { display: flex; align-items: center; justify-content: space-between; padding: 16px; border-bottom: 1px solid rgba(255,255,255,0.1); }\n.notes-header h3 { margin: 0; font-size: 16px; font-weight: 600; }\n.new-note-btn { background: #007aff; border: none; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: white; }\n.new-note-btn:hover { background: #0056b3; }\n.notes-list { flex: 1; overflow-y: auto; }\n.note-item { padding: 12px 16px; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; transition: 0.15s; }\n.note-item:hover { background: rgba(255,255,255,0.05); }\n.note-item.active { background: rgba(0,122,255,0.15); }\n.note-item-title { font-size: 13px; font-weight: 500; margin-bottom: 4px; }\n.note-item-preview { font-size: 11px; opacity: 0.6; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.notes-content { flex: 1; display: flex; flex-direction: column; }\n.note-editor { display: none; flex-direction: column; flex: 1; padding: 20px; }\n.note-editor.active { display: flex; }\n.note-title { background: transparent; border: none; font-size: 24px; font-weight: 600; color: #f5f5f7; outline: none; margin-bottom: 16px; padding: 0; }\n.note-body { flex: 1; background: transparent; border: none; font-size: 14px; color: #f5f5f7; outline: none; resize: none; line-height: 1.6; }\n.empty-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; opacity: 0.5; }\n.empty-state .material-icons { font-size: 64px; margin-bottom: 12px; }\n.empty-state p { font-size: 14px; }\n</style>\n<script>\nvar notes = [];\nvar currentNoteId = null;\n\nfunction loadNotes() {\n  var stored = localStorage.getItem('eos_notes');\n  if (stored) {\n    notes = JSON.parse(stored);\n  } else {\n    notes = [\n      { id: 1, title: 'Добро пожаловать!', body: 'Это ваше первое приложение Заметки в eOS Desktop.\\n\\nВы можете создавать, редактировать и удалять заметки. Все данные сохраняются автоматически.' }\n    ];\n    saveNotes();\n  }\n  renderNotesList();\n}\n\nfunction saveNotes() {\n  localStorage.setItem('eos_notes', JSON.stringify(notes));\n}\n\nfunction renderNotesList() {\n  var list = document.getElementById('notesList');\n  list.innerHTML = notes.map(function(note) {\n    var preview = note.body.substring(0, 50) || 'Пустая заметка';\n    return '<div class=\"note-item ' + (note.id === currentNoteId ? 'active' : '') + '\" onclick=\"selectNote(' + note.id + ')\">' +\n      '<div class=\"note-item-title\">' + (note.title || 'Без названия') + '</div>' +\n      '<div class=\"note-item-preview\">' + preview + '</div>' +\n    '</div>';\n  }).join('');\n}\n\nfunction selectNote(id) {\n  currentNoteId = id;\n  var note = notes.find(function(n) { return n.id === id; });\n  if (note) {\n    document.getElementById('noteTitle').value = note.title || '';\n    document.getElementById('noteBody').value = note.body || '';\n    document.getElementById('noteEditor').classList.add('active');\n    document.getElementById('emptyState').style.display = 'none';\n    renderNotesList();\n  }\n}\n\nfunction createNote() {\n  var newId = notes.length > 0 ? Math.max.apply(null, notes.map(function(n) { return n.id; })) + 1 : 1;\n  var newNote = { id: newId, title: '', body: '' };\n  notes.unshift(newNote);\n  saveNotes();\n  selectNote(newId);\n  document.getElementById('noteTitle').focus();\n}\n\nfunction saveNote() {\n  if (currentNoteId) {\n    var note = notes.find(function(n) { return n.id === currentNoteId; });\n    if (note) {\n      note.title = document.getElementById('noteTitle').value;\n      note.body = document.getElementById('noteBody').value;\n      saveNotes();\n      renderNotesList();\n    }\n  }\n}\n\nloadNotes();\n</script>"
}
