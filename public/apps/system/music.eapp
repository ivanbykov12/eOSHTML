{
  "id": "music_desktop",
  "name": "Музыка",
  "icon": "material:music_note",
  "color": "from-red-500 to-pink-600",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Music player application",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='music-root'>\n  <div class='music-sidebar'>\n    <div class='sidebar-section'>\n      <div class='sidebar-title'>Медиатека</div>\n      <div class='sidebar-item active'>\n        <span class='material-icons'>library_music</span>\n        <span>Все треки</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>album</span>\n        <span>Альбомы</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>person</span>\n        <span>Исполнители</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>playlist_play</span>\n        <span>Плейлисты</span>\n      </div>\n    </div>\n  </div>\n\n  <div class='music-main'>\n    <div class='music-header'>\n      <h2>Все треки</h2>\n    </div>\n\n    <div class='tracks-list'>\n      <div class='track-item'>\n        <div class='track-number'>1</div>\n        <div class='track-info'>\n          <div class='track-title'>Bohemian Rhapsody</div>\n          <div class='track-artist'>Queen</div>\n        </div>\n        <div class='track-album'>A Night at the Opera</div>\n        <div class='track-duration'>5:55</div>\n      </div>\n      <div class='track-item'>\n        <div class='track-number'>2</div>\n        <div class='track-info'>\n          <div class='track-title'>Stairway to Heaven</div>\n          <div class='track-artist'>Led Zeppelin</div>\n        </div>\n        <div class='track-album'>Led Zeppelin IV</div>\n        <div class='track-duration'>8:02</div>\n      </div>\n      <div class='track-item'>\n        <div class='track-number'>3</div>\n        <div class='track-info'>\n          <div class='track-title'>Hotel California</div>\n          <div class='track-artist'>Eagles</div>\n        </div>\n        <div class='track-album'>Hotel California</div>\n        <div class='track-duration'>6:30</div>\n      </div>\n    </div>\n\n    <div class='now-playing'>\n      <div class='np-info'>\n        <div class='np-cover'>\n          <span class='material-icons'>music_note</span>\n        </div>\n        <div class='np-details'>\n          <div class='np-title'>Нет воспроизведения</div>\n          <div class='np-artist'>Выберите трек</div>\n        </div>\n      </div>\n      <div class='np-controls'>\n        <button class='np-btn'>\n          <span class='material-icons'>skip_previous</span>\n        </button>\n        <button class='np-btn play-btn'>\n          <span class='material-icons'>play_arrow</span>\n        </button>\n        <button class='np-btn'>\n          <span class='material-icons'>skip_next</span>\n        </button>\n      </div>\n      <div class='np-progress'>\n        <div class='progress-bar'>\n          <div class='progress-fill'></div>\n        </div>\n        <div class='progress-time'>\n          <span>0:00</span>\n          <span>0:00</span>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.music-root {\n  display: flex;\n  height: 100vh;\n  font-family: -apple-system, sans-serif;\n  background: #1e1e1e;\n  color: #f5f5f7;\n}\n\n.music-sidebar {\n  width: 200px;\n  background: #2a2a2a;\n  border-right: 1px solid rgba(255, 255, 255, 0.1);\n  padding: 16px 0;\n}\n\n.sidebar-section {\n  margin-bottom: 24px;\n}\n\n.sidebar-title {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  opacity: 0.5;\n  padding: 0 16px;\n  margin-bottom: 8px;\n}\n\n.sidebar-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 16px;\n  cursor: pointer;\n  transition: 0.15s;\n  font-size: 13px;\n}\n\n.sidebar-item:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.sidebar-item.active {\n  background: rgba(0, 122, 255, 0.15);\n  color: #007aff;\n}\n\n.sidebar-item .material-icons {\n  font-size: 18px;\n  opacity: 0.7;\n}\n\n.music-main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.music-header {\n  padding: 16px 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.music-header h2 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 600;\n}\n\n.tracks-list {\n  flex: 1;\n  overflow-y: auto;\n}\n\n.track-item {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 12px 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n  cursor: pointer;\n  transition: 0.15s;\n}\n\n.track-item:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.track-number {\n  width: 30px;\n  font-size: 14px;\n  opacity: 0.6;\n}\n\n.track-info {\n  flex: 1;\n}\n\n.track-title {\n  font-size: 14px;\n  font-weight: 500;\n  margin-bottom: 2px;\n}\n\n.track-artist {\n  font-size: 12px;\n  opacity: 0.6;\n}\n\n.track-album {\n  flex: 1;\n  font-size: 13px;\n  opacity: 0.6;\n}\n\n.track-duration {\n  font-size: 13px;\n  opacity: 0.6;\n}\n\n.now-playing {\n  background: #2a2a2a;\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\n  padding: 16px 20px;\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.np-info {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex: 1;\n}\n\n.np-cover {\n  width: 48px;\n  height: 48px;\n  background: linear-gradient(135deg, #667eea, #764ba2);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.np-cover .material-icons {\n  font-size: 24px;\n  color: white;\n}\n\n.np-details {\n  flex: 1;\n}\n\n.np-title {\n  font-size: 14px;\n  font-weight: 500;\n  margin-bottom: 2px;\n}\n\n.np-artist {\n  font-size: 12px;\n  opacity: 0.6;\n}\n\n.np-controls {\n  display: flex;\n  gap: 8px;\n}\n\n.np-btn {\n  background: rgba(255, 255, 255, 0.1);\n  border: none;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: #f5f5f7;\n  transition: 0.15s;\n}\n\n.np-btn:hover {\n  background: rgba(255, 255, 255, 0.15);\n}\n\n.np-btn.play-btn {\n  width: 44px;\n  height: 44px;\n  background: #007aff;\n}\n\n.np-btn.play-btn:hover {\n  background: #0056b3;\n}\n\n.np-progress {\n  flex: 1;\n  max-width: 300px;\n}\n\n.progress-bar {\n  height: 4px;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 2px;\n  margin-bottom: 4px;\n}\n\n.progress-fill {\n  height: 100%;\n  width: 0%;\n  background: #007aff;\n  border-radius: 2px;\n}\n\n.progress-time {\n  display: flex;\n  justify-content: space-between;\n  font-size: 11px;\n  opacity: 0.6;\n}\n</style>\n\n<script>\n// Music app initialized\nconsole.log('Music app loaded');\n</script>"
}
