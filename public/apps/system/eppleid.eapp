{
  "id": "epple_id",
  "name": "Epple ID",
  "icon": "material:account_circle",
  "iconUrl": "https://cdn-icons-png.flaticon.com/512/668/668283.png",
  "color": "from-blue-500 to-indigo-600",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Epple ID Account Management",
  "supportedModels": ["eosdesktop", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='epple-root'>\n  <div class='profile-header'>\n    <div class='avatar-large'>\n      <span class='material-icons'>person</span>\n    </div>\n    <h1 id='userName'>User</h1>\n    <p class='email' id='userEmail'>user@epple.id</p>\n    <button class='edit-btn' onclick='editProfile()'>\n      <span class='material-icons'>edit</span> Изменить\n    </button>\n  </div>\n  \n  <div class='section'>\n    <h2>Учётная запись</h2>\n    <div class='card'>\n      <div class='row'>\n        <span class='material-icons icon'>person</span>\n        <div class='info'>\n          <div class='label'>Имя</div>\n          <div class='value' id='displayName'>User</div>\n        </div>\n      </div>\n      <div class='row'>\n        <span class='material-icons icon'>email</span>\n        <div class='info'>\n          <div class='label'>Epple ID</div>\n          <div class='value' id='eppleId'>user@epple.id</div>\n        </div>\n      </div>\n      <div class='row'>\n        <span class='material-icons icon'>phone</span>\n        <div class='info'>\n          <div class='label'>Телефон</div>\n          <div class='value' id='phone'>+7 (XXX) XXX-XX-XX</div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <div class='section'>\n    <h2>iCloud</h2>\n    <div class='card'>\n      <div class='storage-info'>\n        <div class='storage-header'>\n          <span class='material-icons'>cloud</span>\n          <span>Хранилище iCloud</span>\n        </div>\n        <div class='storage-bar'>\n          <div class='storage-fill' style='width: 42%'></div>\n        </div>\n        <div class='storage-text'>42 ГБ из 100 ГБ использовано</div>\n      </div>\n      <div class='row'>\n        <span class='material-icons icon'>photo</span>\n        <div class='info'>\n          <div class='label'>Фото</div>\n          <div class='value'>12.4 ГБ</div>\n        </div>\n      </div>\n      <div class='row'>\n        <span class='material-icons icon'>description</span>\n        <div class='info'>\n          <div class='label'>Документы</div>\n          <div class='value'>8.2 ГБ</div>\n        </div>\n      </div>\n      <div class='row'>\n        <span class='material-icons icon'>backup</span>\n        <div class='info'>\n          <div class='label'>Резервные копии</div>\n          <div class='value'>21.4 ГБ</div>\n        </div>\n      </div>\n    </div>\n  </div>\n  \n  <div class='section'>\n    <h2>Безопасность</h2>\n    <div class='card'>\n      <div class='row clickable' onclick='changePassword()'>\n        <span class='material-icons icon'>lock</span>\n        <div class='info'>\n          <div class='label'>Пароль</div>\n          <div class='value'>Изменить</div>\n        </div>\n        <span class='material-icons chevron'>chevron_right</span>\n      </div>\n      <div class='row clickable' onclick='twoFactor()'>\n        <span class='material-icons icon'>security</span>\n        <div class='info'>\n          <div class='label'>Двухфакторная аутентификация</div>\n          <div class='value' style='color:#34c759'>Вкл.</div>\n        </div>\n        <span class='material-icons chevron'>chevron_right</span>\n      </div>\n      <div class='row clickable' onclick='devices()'>\n        <span class='material-icons icon'>devices</span>\n        <div class='info'>\n          <div class='label'>Устройства</div>\n          <div class='value'>3 устройства</div>\n        </div>\n        <span class='material-icons chevron'>chevron_right</span>\n      </div>\n    </div>\n  </div>\n  \n  <div class='section'>\n    <h2>Подписки</h2>\n    <div class='card'>\n      <div class='row clickable' onclick='manageSubscription()'>\n        <span class='material-icons icon' style='color:#ff9500'>star</span>\n        <div class='info'>\n          <div class='label'>iCloud+</div>\n          <div class='value'>100 ГБ • 149₽/мес</div>\n        </div>\n        <span class='material-icons chevron'>chevron_right</span>\n      </div>\n      <div class='row clickable' onclick='manageSubscription()'>\n        <span class='material-icons icon' style='color:#ff2d55'>favorite</span>\n        <div class='info'>\n          <div class='label'>eOS Music</div>\n          <div class='value'>Семья • 299₽/мес</div>\n        </div>\n        <span class='material-icons chevron'>chevron_right</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<div id='editModal' class='modal'>\n  <div class='modal-content'>\n    <div class='modal-header'>\n      <h3>Изменить профиль</h3>\n      <button class='close-btn' onclick='closeModal()'>\n        <span class='material-icons'>close</span>\n      </button>\n    </div>\n    <div class='modal-body'>\n      <div class='form-group'>\n        <label>Имя</label>\n        <input type='text' id='editName' class='form-input'>\n      </div>\n      <div class='form-group'>\n        <label>Epple ID (email)</label>\n        <input type='email' id='editEmail' class='form-input'>\n      </div>\n      <div class='form-group'>\n        <label>Телефон</label>\n        <input type='tel' id='editPhone' class='form-input'>\n      </div>\n      <button class='save-btn' onclick='saveProfile()'>Сохранить</button>\n    </div>\n  </div>\n</div>\n\n<style>\n.epple-root {\n  height: 100vh;\n  overflow-y: auto;\n  font-family: -apple-system, sans-serif;\n  background: var(--bg-primary, #1e1e1e);\n  color: var(--text-primary, #f5f5f7);\n  padding: 20px;\n}\n\n.profile-header {\n  text-align: center;\n  padding: 30px 20px;\n  margin-bottom: 20px;\n}\n\n.avatar-large {\n  width: 100px;\n  height: 100px;\n  margin: 0 auto 16px;\n  background: linear-gradient(135deg, #667eea, #764ba2);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.avatar-large .material-icons {\n  font-size: 56px;\n  color: white;\n}\n\n.profile-header h1 {\n  margin: 0 0 8px;\n  font-size: 24px;\n  font-weight: 600;\n}\n\n.email {\n  margin: 0 0 16px;\n  opacity: 0.6;\n  font-size: 14px;\n}\n\n.edit-btn {\n  background: rgba(0, 122, 255, 0.15);\n  color: #007aff;\n  border: none;\n  padding: 8px 20px;\n  border-radius: 20px;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.edit-btn:hover {\n  background: rgba(0, 122, 255, 0.25);\n}\n\n.section {\n  margin-bottom: 24px;\n}\n\n.section h2 {\n  font-size: 16px;\n  font-weight: 600;\n  margin: 0 0 12px;\n  padding-left: 4px;\n}\n\n.card {\n  background: var(--bg-tertiary, rgba(255,255,255,0.05));\n  border-radius: 12px;\n  overflow: hidden;\n  border: 1px solid var(--border-color, rgba(255,255,255,0.1));\n}\n\n.row {\n  display: flex;\n  align-items: center;\n  padding: 12px 16px;\n  border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.05));\n}\n\n.row:last-child {\n  border-bottom: none;\n}\n\n.row.clickable {\n  cursor: pointer;\n  transition: background 0.15s;\n}\n\n.row.clickable:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.row .icon {\n  font-size: 20px;\n  margin-right: 12px;\n  opacity: 0.7;\n}\n\n.row .info {\n  flex: 1;\n}\n\n.row .label {\n  font-size: 14px;\n  margin-bottom: 2px;\n}\n\n.row .value {\n  font-size: 12px;\n  opacity: 0.6;\n}\n\n.row .chevron {\n  opacity: 0.4;\n  font-size: 18px;\n}\n\n.storage-info {\n  padding: 16px;\n  border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.05));\n}\n\n.storage-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n  font-size: 14px;\n}\n\n.storage-bar {\n  height: 6px;\n  background: rgba(255, 255, 255, 0.1);\n  border-radius: 3px;\n  overflow: hidden;\n  margin-bottom: 8px;\n}\n\n.storage-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #007aff, #5ac8fa);\n  border-radius: 3px;\n}\n\n.storage-text {\n  font-size: 12px;\n  opacity: 0.6;\n}\n\n.modal {\n  display: none;\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.6);\n  backdrop-filter: blur(10px);\n  z-index: 10000;\n  align-items: center;\n  justify-content: center;\n}\n\n.modal.active {\n  display: flex;\n}\n\n.modal-content {\n  width: 90%;\n  max-width: 400px;\n  background: var(--bg-secondary, #2a2a2a);\n  border-radius: 16px;\n  overflow: hidden;\n  border: 1px solid var(--border-color, rgba(255,255,255,0.1));\n}\n\n.modal-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 20px;\n  border-bottom: 1px solid var(--border-color, rgba(255,255,255,0.1));\n}\n\n.modal-header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.close-btn {\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 4px;\n  border-radius: 6px;\n  color: inherit;\n  opacity: 0.6;\n}\n\n.close-btn:hover {\n  opacity: 1;\n  background: rgba(255, 255, 255, 0.1);\n}\n\n.modal-body {\n  padding: 20px;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  font-size: 13px;\n  margin-bottom: 6px;\n  opacity: 0.7;\n}\n\n.form-input {\n  width: 100%;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid var(--border-color, rgba(255,255,255,0.1));\n  border-radius: 8px;\n  padding: 10px 12px;\n  font-size: 14px;\n  color: inherit;\n  outline: none;\n}\n\n.form-input:focus {\n  border-color: #007aff;\n}\n\n.save-btn {\n  width: 100%;\n  background: #007aff;\n  color: white;\n  border: none;\n  padding: 12px;\n  border-radius: 10px;\n  font-size: 14px;\n  font-weight: 500;\n  cursor: pointer;\n  margin-top: 8px;\n}\n\n.save-btn:hover {\n  background: #0056b3;\n}\n</style>\n\n<script>\nvar s = window.ePhone ? window.ePhone.getSettings() : {};\n\n// Load user data\nvar userName = s.name || 'User';\nvar userEmail = s.eppleId || (userName.toLowerCase().replace(/\\s+/g, '.') + '@epple.id');\nvar userPhone = s.phone || '+7 (XXX) XXX-XX-XX';\n\ndocument.getElementById('userName').textContent = userName;\ndocument.getElementById('userEmail').textContent = userEmail;\ndocument.getElementById('displayName').textContent = userName;\ndocument.getElementById('eppleId').textContent = userEmail;\ndocument.getElementById('phone').textContent = userPhone;\n\nfunction editProfile() {\n  document.getElementById('editName').value = userName;\n  document.getElementById('editEmail').value = userEmail;\n  document.getElementById('editPhone').value = userPhone;\n  document.getElementById('editModal').classList.add('active');\n}\n\nfunction closeModal() {\n  document.getElementById('editModal').classList.remove('active');\n}\n\nfunction saveProfile() {\n  userName = document.getElementById('editName').value;\n  userEmail = document.getElementById('editEmail').value;\n  userPhone = document.getElementById('editPhone').value;\n  \n  document.getElementById('userName').textContent = userName;\n  document.getElementById('userEmail').textContent = userEmail;\n  document.getElementById('displayName').textContent = userName;\n  document.getElementById('eppleId').textContent = userEmail;\n  document.getElementById('phone').textContent = userPhone;\n  \n  if (window.ePhone) {\n    window.ePhone.setSettings({\n      name: userName,\n      eppleId: userEmail,\n      phone: userPhone\n    });\n  }\n  \n  closeModal();\n}\n\nfunction changePassword() {\n  alert('Функция смены пароля будет доступна в следующем обновлении');\n}\n\nfunction twoFactor() {\n  alert('Двухфакторная аутентификация уже включена');\n}\n\nfunction devices() {\n  alert('Управление устройствами будет доступно в следующем обновлении');\n}\n\nfunction manageSubscription() {\n  alert('Управление подписками будет доступно в следующем обновлении');\n}\n\ndocument.getElementById('editModal').addEventListener('click', function(e) {\n  if (e.target === this) closeModal();\n});\n</script>"
}
