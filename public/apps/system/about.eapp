{
  "id": "about_eos",
  "name": "Об этом eOS",
  "icon": "material:info",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/system-information-2026-09-23/1024.png&w=512",
  "color": "from-purple-500 to-indigo-600",
  "version": "2.1.0",
  "author": "eOS System",
  "description": "System Information Window",
  "supportedModels": ["eosdesktop", "iphone14", "epad101"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "transparent",
  "code": "<div class='about-container'>\n  <div class='titlebar'>\n    <div class='traffic-lights'>\n      <button class='traffic-light close' onclick='closeWindow()'>\n        <span class='material-icons'>close</span>\n      </button>\n      <button class='traffic-light minimize' onclick='minimizeWindow()'>\n        <span class='material-icons'>remove</span>\n      </button>\n    </div>\n    <div class='titlebar-text'>Об этом Mak mini</div>\n    <div class='titlebar-spacer'></div>\n  </div>\n\n  <div class='content'>\n    <div class='pc-icon'>\n      <img src='https://img.icons8.com/?size=100&id=IGMhxmTmFYuW&format=png' alt='Mak mini' />\n    </div>\n\n    <h1 class='device-name'>Mak mini</h1>\n\n    <div class='specs'>\n      <div class='spec-row'>\n        <span class='spec-label'>Процессор</span>\n        <span class='spec-value'>Apple M3 Pro</span>\n      </div>\n      <div class='spec-row'>\n        <span class='spec-label'>Память</span>\n        <span class='spec-value'>18 ГБ</span>\n      </div>\n      <div class='spec-row'>\n        <span class='spec-label'>Разрешение</span>\n        <span class='spec-value' id='screenResolution'>Определение...</span>\n      </div>\n      <div class='spec-row'>\n        <span class='spec-label'>Серийный номер</span>\n        <span class='spec-value mono' id='serialNumber'>FVFXXXXXXXXX</span>\n      </div>\n      <div class='spec-row'>\n        <span class='spec-label'>ОС</span>\n        <span class='spec-value' id='osVersion'>eOS Desktop 10.1 beta</span>\n      </div>\n      <div class='spec-row'>\n        <span class='spec-label'>Ядро</span>\n        <span class='spec-value'>eOS-Darwin 23.0</span>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.about-container {\n  width: 580px;\n  height: 420px;\n  display: flex;\n  flex-direction: column;\n  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;\n  background: rgba(30, 30, 30, 0.7);\n  backdrop-filter: blur(40px) saturate(180%);\n  -webkit-backdrop-filter: blur(40px) saturate(180%);\n  border-radius: 12px;\n  overflow: hidden;\n  border: 1px solid rgba(255, 255, 255, 0.15);\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\n  color: #f5f5f7;\n}\n\n.titlebar {\n  height: 28px;\n  background: rgba(40, 40, 40, 0.8);\n  display: flex;\n  align-items: center;\n  padding: 0 12px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n  flex-shrink: 0;\n}\n\n.traffic-lights {\n  display: flex;\n  gap: 8px;\n}\n\n.traffic-light {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: all 0.15s;\n  padding: 0;\n}\n\n.traffic-light .material-icons {\n  font-size: 8px;\n  opacity: 0;\n  transition: opacity 0.15s;\n  color: rgba(0, 0, 0, 0.6);\n}\n\n.traffic-light:hover .material-icons {\n  opacity: 1;\n}\n\n.traffic-light.close {\n  background: #ff5f57;\n}\n\n.traffic-light.close:hover {\n  background: #ff3b30;\n}\n\n.traffic-light.minimize {\n  background: #ffbd2e;\n}\n\n.traffic-light.minimize:hover {\n  background: #ff9500;\n}\n\n.titlebar-text {\n  flex: 1;\n  text-align: center;\n  font-size: 13px;\n  font-weight: 500;\n  opacity: 0.9;\n}\n\n.titlebar-spacer {\n  width: 52px;\n}\n\n.content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 30px 40px;\n  overflow: hidden;\n}\n\n.pc-icon {\n  width: 100px;\n  height: 100px;\n  margin-bottom: 20px;\n  filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.3));\n}\n\n.pc-icon img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.device-name {\n  font-size: 28px;\n  font-weight: 600;\n  margin: 0 0 24px;\n  letter-spacing: -0.5px;\n  text-align: center;\n}\n\n.specs {\n  width: 100%;\n  max-width: 400px;\n}\n\n.spec-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 8px 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.spec-row:last-child {\n  border-bottom: none;\n}\n\n.spec-label {\n  font-size: 13px;\n  opacity: 0.6;\n  font-weight: 500;\n}\n\n.spec-value {\n  font-size: 13px;\n  font-weight: 500;\n  text-align: right;\n}\n\n.spec-value.mono {\n  font-family: 'SF Mono', 'Fira Code', monospace;\n  font-size: 12px;\n}\n</style>\n\n<script>\nfunction generateSerial() {\n  var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';\n  var serial = 'FVF';\n  for (var i = 0; i < 8; i++) {\n    serial += chars.charAt(Math.floor(Math.random() * chars.length));\n  }\n  return serial;\n}\n\nvar ctx = window.ePhoneContext || {};\ndocument.getElementById('osVersion').textContent = 'eOS Desktop ' + (ctx.osVersion || '10.1 beta');\ndocument.getElementById('serialNumber').textContent = generateSerial();\n\nvar screenWidth = window.screen.width;\nvar screenHeight = window.screen.height;\nvar pixelRatio = window.devicePixelRatio || 1;\nvar actualWidth = Math.round(screenWidth * pixelRatio);\nvar actualHeight = Math.round(screenHeight * pixelRatio);\ndocument.getElementById('screenResolution').textContent = actualWidth + ' × ' + actualHeight + (pixelRatio > 1 ? ' (Retina)' : '');\n\nfunction closeWindow() {\n  if (window.ePhone) {\n    window.ePhone.close();\n  }\n}\n\nfunction minimizeWindow() {\n  if (window.ePhone) {\n    window.ePhone.minimize();\n  }\n}\n</script>"
}
