{
  "id": "photos_desktop",
  "name": "Фото",
  "icon": "material:photo_library",
  "iconUrl": "https://cdn.jim-nielsen.com/.netlify/images?url=/icongallery/macos/photos-2026-09-23/1024.png&w=512",
  "color": "from-pink-500 to-rose-500",
  "version": "1.0.0",
  "author": "eOS System",
  "description": "Photo viewer and manager",
  "supportedModels": ["eosdesktop"],
  "isSystem": true,
  "eappVersion": "1.1",
  "background": "#1e1e1e",
  "code": "<div class='photos-root'>\n  <div class='photos-sidebar'>\n    <div class='sidebar-section'>\n      <div class='sidebar-title'>Медиатека</div>\n      <div class='sidebar-item active'>\n        <span class='material-icons'>photo_library</span>\n        <span>Все фото</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>favorite</span>\n        <span>Избранное</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>video_library</span>\n        <span>Видео</span>\n      </div>\n    </div>\n    <div class='sidebar-section'>\n      <div class='sidebar-title'>Альбомы</div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>folder</span>\n        <span>Недавние</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>folder</span>\n        <span>Путешествия</span>\n      </div>\n      <div class='sidebar-item'>\n        <span class='material-icons'>folder</span>\n        <span>Семья</span>\n      </div>\n    </div>\n  </div>\n\n  <div class='photos-main'>\n    <div class='photos-header'>\n      <h2>Все фото</h2>\n      <div class='view-controls'>\n        <button class='view-btn active'>\n          <span class='material-icons'>grid_view</span>\n        </button>\n        <button class='view-btn'>\n          <span class='material-icons'>view_list</span>\n        </button>\n      </div>\n    </div>\n\n    <div class='photos-grid' id='photosGrid'>\n      <div class='photo-placeholder'>\n        <span class='material-icons'>image</span>\n        <p>Нет фотографий</p>\n        <small>Перетащите изображения сюда или импортируйте их</small>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n.photos-root {\n  display: flex;\n  height: 100vh;\n  font-family: -apple-system, sans-serif;\n  background: #1e1e1e;\n  color: #f5f5f7;\n}\n\n.photos-sidebar {\n  width: 200px;\n  background: #2a2a2a;\n  border-right: 1px solid rgba(255, 255, 255, 0.1);\n  padding: 16px 0;\n  overflow-y: auto;\n}\n\n.sidebar-section {\n  margin-bottom: 24px;\n}\n\n.sidebar-title {\n  font-size: 11px;\n  font-weight: 600;\n  text-transform: uppercase;\n  opacity: 0.5;\n  padding: 0 16px;\n  margin-bottom: 8px;\n}\n\n.sidebar-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 16px;\n  cursor: pointer;\n  transition: 0.15s;\n  font-size: 13px;\n}\n\n.sidebar-item:hover {\n  background: rgba(255, 255, 255, 0.05);\n}\n\n.sidebar-item.active {\n  background: rgba(0, 122, 255, 0.15);\n  color: #007aff;\n}\n\n.sidebar-item .material-icons {\n  font-size: 18px;\n  opacity: 0.7;\n}\n\n.photos-main {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.photos-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 16px 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n\n.photos-header h2 {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 600;\n}\n\n.view-controls {\n  display: flex;\n  gap: 4px;\n}\n\n.view-btn {\n  background: rgba(255, 255, 255, 0.05);\n  border: none;\n  width: 32px;\n  height: 32px;\n  border-radius: 6px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: #f5f5f7;\n  transition: 0.15s;\n}\n\n.view-btn:hover {\n  background: rgba(255, 255, 255, 0.1);\n}\n\n.view-btn.active {\n  background: rgba(0, 122, 255, 0.2);\n  color: #007aff;\n}\n\n.photos-grid {\n  flex: 1;\n  overflow-y: auto;\n  padding: 20px;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));\n  gap: 12px;\n}\n\n.photo-placeholder {\n  grid-column: 1 / -1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 80px 20px;\n  text-align: center;\n  opacity: 0.5;\n}\n\n.photo-placeholder .material-icons {\n  font-size: 64px;\n  margin-bottom: 16px;\n}\n\n.photo-placeholder p {\n  margin: 0 0 8px;\n  font-size: 16px;\n}\n\n.photo-placeholder small {\n  font-size: 13px;\n  opacity: 0.7;\n}\n</style>\n\n<script>\n// Photos app initialized\nconsole.log('Photos app loaded');\n</script>"
}
